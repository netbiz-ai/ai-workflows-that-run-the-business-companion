     "order",
     "channel",
     "amount"
    ],
    "control_column": "amount",
    "manual": false,
    "data_owner": "owen@example.test"
   },
   {
    "id": "delivery",
    "name": "Delivery scheduling",
    "export_path": "exports/delivery",
    "control_path": "controls/delivery",
    "columns": [
     "work_order",
     "state",
     "overdue"
    ],
    "control_column": "",
    "manual": false,
    "data_owner": "tom@example.test"
   },
   {
    "id": "accounting",
    "name": "Accounting",
    "export_path": "exports/accounting",
    "control_path": "controls/accounting",
