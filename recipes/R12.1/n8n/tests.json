     "task",
     "done"
    ],
    "control_column": "",
    "manual": false,
    "data_owner": "tasks-owner@example.test"
   },
   {
    "id": "hr_form",
    "name": "HR weekly form",
    "export_path": "exports/hr_form",
    "control_path": "controls/hr_form",
    "columns": [
     "employee_ref",
     "type"
    ],
    "control_column": "",
    "manual": true,
    "data_owner": "aisha@example.test"
   }
  ],
  "measures": [
   {
    "id": "open-tickets",
    "name": "Open tickets",
    "source": "helpdesk",
    "kind": "status",
    "people": false,
    "formula": {
     "op": "count",
     "where": {
      "status": "open"
     }
    },
    "rule_version": "v1"
   },
   {
    "id": "sales",
    "name": "Online and store sales",
    "source": "shop",
    "kind": "period",
    "people": false,
    "formula": {
     "op": "sum",
     "column": "amount"
    },
    "rule_version": "v1"
   },
   {
    "id": "overdue-work-orders",
    "name": "Overdue work orders",
    "source": "delivery",
    "kind": "status",
    "people": false,
    "formula": {
     "op": "count",
     "where": {
      "overdue": true
     }
    },
    "rule_version": "v1"
   },
   {
    "id": "completed-deliveries",
    "name": "Completed deliveries",
    "source": "delivery",
    "kind": "period",
    "people": false,
    "formula": {
     "op": "count",
     "where": {
      "state": "completed"
     }
    },
    "rule_version": "v1"
   },
   {
    "id": "receivables-overdue",
    "name": "Overdue receivables",
    "source": "accounting",
    "kind": "status",
    "people": false,
    "formula": {
     "op": "sum",
     "column": "amount",
     "where": {
      "overdue": true
     }
    },
    "rule_version": "v1"
   },
   {
    "id": "open-tasks",
    "name": "Open tasks",
    "source": "tasks",
    "kind": "status",
    "people": false,
    "formula": {
     "op": "count",
     "where": {
      "done": false
     }
    },
    "rule_version": "v1"
   },
   {
    "id": "staff-absences",
    "name": "Staff absences",
    "source": "hr_form",
    "kind": "period",
    "people": true,
    "formula": {
     "op": "count"
    },
    "rule_version": "v1"
   }
  ],
  "report_builder": "owen@example.test",
  "rule_approver": "aisha@example.test"
 },
