   ],
   "trigger": [
    {
     "webhook": "r7-1-attachment",
     "body": {
      "message_id": "M-1",
      "attachment_id": "A-1"
     },
     "pause": 0.3
    }
   ],
   "expect": [
    {
     "calls": "POST /review/records",
