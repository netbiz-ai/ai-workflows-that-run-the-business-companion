        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 8: Read the approval\": \"in1_Step8Readtheapproval\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 8: Read the approval\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 8: Approval decided').first().json.body.\nDATA[\"Step 8: Approval decided\"] = [{ json: { body: { \"invoice_id\": input.t_invoice_id, \"decision\": input.t_decision, \"decided_by\": input.t_decided_by } } }];\nconst BODIES = (out) => ({\"decision_body\": JSON.stringify({ status: $('Step 8: Approval decided').first().json.body.decision, decided_by: $('Step 8: Approval decided').first().json.body.decided_by, decided_at: new Date().toISOString() }), \"log_body\": JSON.stringify({ recipe: 'R7.2', item: $('Step 8: Approval decided').first().json.body.invoice_id, decision: 'approval ' + $('Step 8: Approval decided').first().json.body.decision, rules: { approver: $('Step 8: Read the approval').first().json.approver, tolerance_version: $('Step 8: Read the approval').first().json.tolerance_version }, approved_by: $('Step 8: Approval decided').first().json.body.decided_by }), \"message_body\": JSON.stringify({ to: $('Config').first().json.purchasing, subject: 'Confirm AI pairings for invoice ' + $('Step 8: Approval decided').first().json.body.invoice_id, text: 'Approved with AI-paired lines; add the ones you confirm to the supplier-item map: ' + ($('Step 8: Read the approval').first().json.lines || []).filter(l => l.ai_paired).map(l => l.description + ' -> ' + l.order_line_id).join('; ') })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// The step 8 and 9 bodies, as the n8n build writes them inline.\nconst ap = $('Step 8: Read the approval').first().json;\nreturn [{ json: { ai_paired: (ap.lines || []).some(l => l.ai_paired) ? 'yes' : 'no' } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
