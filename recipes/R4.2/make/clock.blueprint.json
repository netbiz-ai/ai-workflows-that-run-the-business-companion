        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Any clock running?\": \"in1_Anyclockrunning\", \"Read the ticket's assignee\": \"in2_Readtheticketsassignee\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read the ticket's assignee\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"ack_log_body\": JSON.stringify({ recipe: 'R4.2', item: out.ticket_id, decision: 'acknowledged by ' + out.by, rules: { message_id: out.message_id, level: out.level, by: out.by, minutes: out.minutes, clock: 'stopped' } }), \"text_body\": (out.person ? JSON.stringify({ to: out.person.phone, text: 'Escalated ticket: ' + $('Config').first().json.ticket_link + out.ticket_id }) : null), \"call_body\": (out.person ? JSON.stringify({ to: out.person.phone, say: 'An escalated ticket needs you now. The link is in your texts.' }) : null), \"text_failed_body\": (out.person ? JSON.stringify({ recipe: 'R4.2', item: out.ticket_id, reason: 'notice failed', detail: 'Text to ' + out.person.name + ' failed after three tries', owner: $('Config').first().json.triage_lead }) : null), \"call_failed_body\": (out.person ? JSON.stringify({ recipe: 'R4.2', item: out.ticket_id, reason: 'notice failed', detail: 'Call to ' + out.person.name + ' failed after three tries', owner: $('Config').first().json.triage_lead }) : null), \"notice_log_body\": (out.person ? JSON.stringify({ recipe: 'R4.2', item: out.ticket_id, decision: 'escalated: ' + out.level + ' notified', rules: Object.assign({}, out.rules, { message_id: out.message_id, fired: out.fired, level: out.level, person: out.person.name, rota: out.rota, limit_min: out.limit_min, notified: out.notified, clock: out.level === 'final' ? 'ended' : 'running' }) }) : null)});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 6: the person notified taking the ticket stops the clock; a passed limit notifies the next person on a fresh clock.\nconst cfg = $('Config').first().json;\nconst clocks = $('Any clock running?').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const c = clocks[i].json;\n  const r = c.rules;\n  const t = it.json;\n  if (t.assignee && (r.notified || []).includes(t.assignee)) {\n    out.push({ json: { action: 'ack', ticket_id: c.item, by: t.assignee, level: r.level, minutes: Math.round(Number(c.minutes)), message_id: r.message_id }, pairedItem: { item: i } });\n    return;\n  }\n  if (Number(c.minutes) < Number(r.limit_min)) return;\n  const next = r.level === 'owner' ? { level: 'backup', person: cfg[r.rota].backup } : { level: 'final', person: cfg.final_contact };\n  out.push({ json: { action: 'notify', ticket_id: c.item, message_id: r.message_id, level: next.level, rota: r.rota, person: next.person,\n    limit_min: cfg[r.rota].limit_min, fired: `${r.level} did not take the ticket within ${r.limit_min} minutes`,\n    notified: (r.notified || []).concat([next.person.helpdesk_user]), rules: {} }, pairedItem: { item: i } });\n});\nreturn out;\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
