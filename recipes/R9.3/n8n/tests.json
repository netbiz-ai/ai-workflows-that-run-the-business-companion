{
  "config": {
    "employees_url": "{mocks}/employees",
    "balances_url": "{mocks}/balances",
    "requests_url": "{mocks}/leave",
    "record_list_url": "{mocks}/torecord",
    "messaging_url": "{mocks}/messaging",
    "hr_owner": "aisha@example.test",
    "protected_types": ["sick", "family"],
    "notice_days": {"vacation": 14}
  },
  "seed": {
    "employees": {"employees": {
      "E-1": {"id": "E-1", "email": "staff@example.test", "name": "Staff Member", "manager": "manager@example.test",
              "stand_in": "tom@example.test", "work_days": [1, 2, 3, 4, 5, 6, 7]},
      "E-2": {"id": "E-2", "email": "colleague@example.test", "name": "Colleague", "manager": "manager@example.test",
              "stand_in": "tom@example.test", "work_days": [1, 2, 3, 4, 5, 6, 7]}
    }},
    "balances": {"balances": {"B-1": {"id": "B-1", "employee_id": "E-1", "type": "vacation", "days": 10, "as_of": "{today}"}}}
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "Three days, balance ten",
     "trigger": [{"webhook": "r9-3-leave", "pause": 3, "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "request"}},
                 {"webhook": "r9-3-decision", "body": {"request_id": "R-1", "decision": "approved", "by": "manager@example.test"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "approved"},
       {"mock": "leave/requests/R-1", "field": "days", "equals": 3},
       {"mock": "leave/requests/R-1", "field": "warnings", "equals": []},
       {"mock": "torecord/items", "count": 1},
       {"calls": "POST /messaging/messages", "count": 2},
       {"sql": "select string_agg(decision, ', ' order by id) from decision_log where recipe='R9.3'", "equals": "to the manager, approved"},
       {"sql": "select status || ' / ' || result from key_log where recipe='R9.3'", "equals": "done / closed: approved"}]},
    {"case": "Edge", "row": 2, "input": "Two open requests over the balance",
     "trigger": [{"webhook": "r9-3-leave", "pause": 3, "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+25}", "action": "request"}},
                 {"webhook": "r9-3-leave", "body": {"request_id": "R-2", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+30}", "end": "{today+34}", "action": "request"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "warnings", "equals": []},
       {"mock": "leave/requests/R-2", "field": "status", "equals": "with manager"},
       {"mock": "leave/requests/R-2", "field": "warnings", "contains": "balance less open requests (4) does not cover 5 days"},
       {"calls": "POST /messaging/messages", "count": 2}]},
    {"case": "Duplicate", "row": 3, "input": "Submitted twice",
     "trigger": [{"webhook": "r9-3-leave", "pause": 3, "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "request"}},
                 {"webhook": "r9-3-leave", "body": {"request_id": "R-2", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "request"}}],
     "expect": [
       {"mock": "leave/requests", "count": 1},
       {"calls": "POST /messaging/messages", "count": 1},
       {"sql": "select copies_skipped from key_log where recipe='R9.3'", "equals": "1"}]},
    {"case": "Escalate", "row": 4, "input": "Family leave",
     "trigger": [{"webhook": "r9-3-leave", "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "family",
                  "start": "{today+3}", "end": "{today+5}", "action": "request"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "with HR"},
       {"mock": "leave/requests/R-1", "field": "decider", "equals": "aisha@example.test"},
       {"calls": "POST /messaging/messages", "count": 1},
       {"calls": "GET /balances/balances", "count": 0},
       {"sql": "select decision from decision_log where recipe='R9.3'", "equals": "to HR alone"}]},
    {"case": "Balance export missing", "row": 5, "input": "Today's balance is not in the export (companion extension)",
     "seed": {"balances": {"balances": {"B-1": {"as_of": "{today-1}"}}}},
     "trigger": [{"webhook": "r9-3-leave", "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "request"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "with manager"},
       {"mock": "leave/requests/R-1", "field": "warnings", "equals": ["balance not checked"]},
       {"calls": "POST /messaging/messages", "count": 1}]},
    {"case": "Employee notice fails", "row": 6, "input": "The decision is made and the notice fails (companion extension)",
     "seed": {"leave": {"requests": {"R-1": {"id": "R-1", "key": "E-1:vacation:{today+20}:{today+22}", "employee_id": "E-1", "employee": "staff@example.test",
              "name": "Staff Member", "type": "vacation", "start": "{today+20}", "end": "{today+22}", "days": 3, "warnings": [],
              "manager": "manager@example.test", "stand_in": "tom@example.test", "decider": "manager@example.test", "status": "with manager",
              "sent_on": "{today}", "reminded": false}}}},
     "fail": [{"method": "POST", "path": "/messaging/messages", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r9-3-decision", "body": {"request_id": "R-1", "decision": "approved", "by": "manager@example.test"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "approved"},
       {"mock": "torecord/items", "count": 1},
       {"calls": "POST /messaging/messages", "count": 1},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R9.3'", "equals": "employee notice failed / aisha@example.test"}]},
    {"case": "Manager silent", "row": 7, "input": "No decision after 4 working days (companion extension)",
     "seed": {"leave": {"requests": {"R-1": {"id": "R-1", "key": "E-1:vacation:{today+20}:{today+22}", "employee_id": "E-1", "employee": "staff@example.test",
              "name": "Staff Member", "type": "vacation", "start": "{today+20}", "end": "{today+22}", "days": 3, "warnings": [],
              "manager": "manager@example.test", "stand_in": "tom@example.test", "decider": "manager@example.test", "status": "with manager",
              "sent_on": "{today-6}", "reminded": true}}}},
     "trigger": [{"schedule": "Step 6: Morning reminders"}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "with stand-in"},
       {"mock": "leave/requests/R-1", "field": "decider", "equals": "tom@example.test"},
       {"calls": "POST /messaging/messages", "count": 2}]},
    {"case": "Unlisted requester", "row": 8, "input": "A requester not on the employee list (companion extension)",
     "trigger": [{"webhook": "r9-3-leave", "body": {"request_id": "R-1", "employee": "someone@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "request"}}],
     "expect": [
       {"mock": "leave/requests", "count": 0},
       {"calls": "POST /messaging/messages", "count": 1},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R9.3'", "equals": "unlisted requester / aisha@example.test"}]},
    {"case": "Cancellation", "row": 9, "input": "An approved request is cancelled (companion extension)",
     "seed": {"leave": {"requests": {"R-1": {"id": "R-1", "key": "E-1:vacation:{today+20}:{today+22}", "employee_id": "E-1", "employee": "staff@example.test",
              "name": "Staff Member", "type": "vacation", "start": "{today+20}", "end": "{today+22}", "days": 3, "warnings": [],
              "manager": "manager@example.test", "stand_in": "tom@example.test", "decider": "manager@example.test", "status": "approved",
              "sent_on": "{today-2}", "reminded": false}}}},
     "trigger": [{"webhook": "r9-3-leave", "body": {"request_id": "R-1", "employee": "staff@example.test", "type": "vacation",
                  "start": "{today+20}", "end": "{today+22}", "action": "cancel"}}],
     "expect": [
       {"mock": "leave/requests/R-1", "field": "status", "equals": "cancelled"},
       {"calls": "POST /messaging/messages", "count": 2},
       {"sql": "select decision from decision_log where recipe='R9.3'", "equals": "cancelled"}]}
  ]
}
