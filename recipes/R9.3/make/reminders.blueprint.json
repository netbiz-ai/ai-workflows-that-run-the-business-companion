        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 6: Read requests with the manager\": \"in1_Step6Readrequestswiththe\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 6: Read requests with the manager\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"id_q\": encodeURIComponent(out.id), \"remind_message\": JSON.stringify({ to: out.manager, subject: 'Reminder: leave request ' + out.id + ' from ' + out.name, text: 'Waiting ' + out.waited + ' working days. Warnings: ' + ((out.warnings || []).join('; ') || 'none') }), \"reminded_body\": JSON.stringify({ reminded: true }), \"standin_body\": JSON.stringify({ status: 'with stand-in', decider: out.stand_in }), \"standin_message\": JSON.stringify({ to: out.stand_in, subject: 'Leave request ' + out.id + ' from ' + out.name + ': please decide', text: out.manager + ' has not answered in ' + out.waited + ' working days. Warnings: ' + ((out.warnings || []).join('; ') || 'none') }), \"hr_message\": JSON.stringify({ to: $('Config').first().json.hr_owner, subject: 'Leave request ' + out.id + ' moved to the stand-in', text: 'No answer from ' + out.manager + ' in ' + out.waited + ' working days; sent to ' + out.stand_in + '.' }), \"failed_body\": JSON.stringify({ recipe: 'R9.3', item: out.id, reason: 'reminder failed', detail: 'A reminder or stand-in step failed, never retried; chase the decider', owner: $('Config').first().json.hr_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\nconst isoToday = () => new Date().toISOString().slice(0, 10);\nconst day = d => new Date(String(d).slice(0, 10) + 'T00:00:00Z');\nconst isDate = d => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(d || '')) && !isNaN(day(d));\n// Working days (Monday to Friday) after the date, up to and including today.\nfunction workingDaysSince(d) {\n  let n = 0;\n  for (let x = new Date(day(d).getTime() + 86400000); x <= day(isoToday()); x = new Date(x.getTime() + 86400000)) {\n    if (x.getUTCDay() % 6 !== 0) n++;\n  }\n  return n;\n}\n\n// Step 6: remind the manager at 2 working days; at 4 go to the stand-in and tell HR.\nconst cfg = $('Config').first().json;\nconst open = $('Step 6: Read requests with the manager').first().json.items || [];\nconst out = [];\nfor (const r of open) {\n  const n = workingDaysSince(r.sent_on);\n  if (n >= cfg.standin_working_days) out.push({ json: Object.assign({}, r, { action: 'stand-in', waited: n }) });\n  else if (n >= cfg.remind_working_days && !r.reminded) out.push({ json: Object.assign({}, r, { action: 'remind', waited: n }) });\n}\nreturn out;\n};\nreturn { items: one(__rule()).map(o => Object.assign({}, o, BODIES(o))) };\n",
        "input": [
