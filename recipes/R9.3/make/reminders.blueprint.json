        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\n// Schedule: set this scenario to run every day at 08:00; Make keeps the schedule outside the blueprint.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R9.3\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"employees_url\": \"https://<your employee list API>\",\n  \"balances_url\": \"https://<your daily balance export API>\",\n  \"requests_url\": \"https://<your leave request list API>\",\n  \"record_list_url\": \"https://<your HR to-record list API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"hr_owner\": \"<your HR owner>\",\n  \"protected_types\": [\n    \"<leave types that go to HR alone, such as sick and family>\"\n  ],\n  \"notice_days\": {\n    \"<leave type>\": 0\n  },\n  \"remind_working_days\": 2,\n  \"standin_working_days\": 4\n};",
