        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 6: Read the request\": \"in1_Step6Readtherequest\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 6: Read the request\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 6: Manager decides').first().json.body.\nDATA[\"Step 6: Manager decides\"] = [{ json: { body: { \"request_id\": input.t_request_id, \"decision\": input.t_decision, \"by\": input.t_by } } }];\nconst BODIES = (out) => ({\"id_q\": encodeURIComponent(out.id || ''), \"key_q\": encodeURIComponent(out.key || ''), \"record_body\": JSON.stringify({ status: out.decision, decided_by: out.decided_by, decided_on: out.decided_on }), \"torecord_body\": JSON.stringify({ request_id: out.id, employee_id: out.employee_id, name: out.name, type: out.type, start: out.start, end: out.end, days: out.days, warnings: out.warnings || [], decided_by: out.decided_by, task: 'Re-check the balance as you record it' }), \"notify_message\": JSON.stringify({ to: out.employee, subject: 'Your leave request ' + out.id + ' was ' + out.decision, text: out.type + ' leave, ' + out.start + ' to ' + out.end + ': ' + out.decision + ' by ' + out.decided_by + '.' }), \"done_body\": JSON.stringify({ status: 'done', result: 'closed: ' + out.decision }), \"log_body\": JSON.stringify({ recipe: 'R9.3', item: out.id, decision: out.decision, rules: { decided_by: out.decided_by, warnings: out.warnings || [] } }), \"notice_failed_body\": JSON.stringify({ recipe: 'R9.3', item: out.id, reason: 'employee notice failed', detail: 'The employee was not told (send error); HR tells them', owner: $('Config').first().json.hr_owner }), \"failed_body\": JSON.stringify({ recipe: 'R9.3', item: $('Step 6: Manager decides').first().json.body.request_id, reason: 'write failed', detail: 'A leave write failed, never retried', owner: $('Config').first().json.hr_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 6: the manager, stand-in or HR decides a request that is still open.\nconst d = $('Step 6: Manager decides').first().json.body;\nconst r = ($('Step 6: Read the request').first().json.items || [])[0];\nif (!r || !['with manager', 'with stand-in', 'with HR'].includes(r.status) || !['approved', 'declined'].includes(d.decision)) return [];\nreturn [{ json: Object.assign({}, r, { decision: d.decision, decided_by: d.by || r.decider, decided_on: new Date().toISOString().slice(0, 10) }) }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
