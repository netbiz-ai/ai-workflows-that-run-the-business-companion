                "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Read the message\": \"in1_Readthemessage\", \"Step 4: AI call\": \"in2_Step4AIcall\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 4: AI call\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"set_body\": JSON.stringify({ category: out.category, queue: out.queue }), \"triage_body\": JSON.stringify({ queue: $('Config').first().json.triage_queue }), \"exception_body\": JSON.stringify({ recipe: 'R4.1', item: $('Read the message').first().json.id, reason: 'needs manual triage', detail: out.reason + ': ' + (out.detail || ''), owner: $('Config').first().json.triage_lead }), \"done_body\": JSON.stringify({ status: 'done', result: 'routed' }), \"log_body\": JSON.stringify({ recipe: 'R4.1', item: $('Read the message').first().json.id, decision: out.route === 'set' ? 'set ' + out.category : 'manual triage: ' + out.reason, rules: out.rules || { ai: 'error' } }), \"failed_body\": JSON.stringify({ recipe: 'R4.1', item: $('Read the message').first().json.id, reason: 'write failed', detail: 'Routing write failed; check the ticket, never retried', owner: $('Config').first().json.triage_lead })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\nif (Number(input.ai_status) !== 200) return (($json) => {\nreturn [{ json: { route: 'exception', reason: 'AI error after one retry', detail: String(($json.error && $json.error.message) || '') } }];\n})({ error: { message: 'AI call returned ' + (input.ai_status || 'no answer') } });\n// Parse an AI reply and check it against the prompt's schema; never trust it otherwise.\nfunction parseAi(reply, required, enums = {}) {\n  const text = ((reply && reply.content) || []).filter(c => c.type === 'text').map(c => c.text).join('').trim()\n    .replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '');\n  let out;\n  try { out = JSON.parse(text); } catch (e) { return { ok: false, problem: 'reply is not JSON' }; }\n  if (!out || typeof out !== 'object' || Array.isArray(out)) return { ok: false, problem: 'reply is not an object' };\n  for (const k of required) if (!(k in out)) return { ok: false, problem: `missing field ${k}` };\n  for (const [k, allowed] of Object.entries(enums)) if (!allowed.includes(out[k])) return { ok: false, problem: `${k} not one of ${allowed.join(', ')}` };\n  return { ok: true, value: out };\n}\n\n// Step 5: use the category only if it is listed exactly, confidence is high and the language is covered.\nconst cfg = $('Config').first().json;\nconst p = parseAi($('Step 4: AI call').first().json, ['category', 'confidence', 'language'], { confidence: ['high', 'medium', 'low'] });\nif (!p.ok) return [{ json: { route: 'exception', reason: 'AI output failed the check', detail: p.problem } }];\nconst ai = p.value;\nconst listed = cfg.categories.find(c => c.name === ai.category);\nconst covered = cfg.covered_languages.includes(ai.language);\nconst rules = { listed: !!listed, confidence: ai.confidence, language: ai.language, covered };\nif (listed && ai.confidence === 'high' && covered) {\n  return [{ json: { route: 'set', category: listed.name, queue: listed.queue, confidence: ai.confidence, rules } }];\n}\nconst reason = !covered ? 'language not covered' : !listed ? 'category not listed' : 'confidence not high';\nreturn [{ json: { route: 'exception', reason, detail: `AI suggested ${ai.category} (${ai.confidence}, ${ai.language})`, rules } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
