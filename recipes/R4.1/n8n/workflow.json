      "id": "5ff467d5-2f77-575c-886a-2c9b2c9ca44b",
      "name": "Step 4: AI call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2600,
        120
      ],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Your Anthropic API key"
        }
      },
      "notes": "Claude Haiku 5.5 by default (Config); tools none; the reply is checked by the rule that follows.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// Parse an AI reply and check it against the prompt's schema; never trust it otherwise.\nfunction parseAi(reply, required, enums = {}) {\n  const text = ((reply && reply.content) || []).filter(c => c.type === 'text').map(c => c.text).join('').trim()\n    .replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '');\n  let out;\n  try { out = JSON.parse(text); } catch (e) { return { ok: false, problem: 'reply is not JSON' }; }\n  if (!out || typeof out !== 'object' || Array.isArray(out)) return { ok: false, problem: 'reply is not an object' };\n  for (const k of required) if (!(k in out)) return { ok: false, problem: `missing field ${k}` };\n  for (const [k, allowed] of Object.entries(enums)) if (!allowed.includes(out[k])) return { ok: false, problem: `${k} not one of ${allowed.join(', ')}` };\n  return { ok: true, value: out };\n}\n\n// Step 5: use the category only if it is listed exactly, confidence is high and the language is covered.\nconst cfg = $('Config').first().json;\nconst p = parseAi($('Step 4: AI call').first().json, ['category', 'confidence', 'language'], { confidence: ['high', 'medium', 'low'] });\nif (!p.ok) return [{ json: { route: 'exception', reason: 'AI output failed the check', detail: p.problem } }];\nconst ai = p.value;\nconst listed = cfg.categories.find(c => c.name === ai.category);\nconst covered = cfg.covered_languages.includes(ai.language);\nconst rules = { listed: !!listed, confidence: ai.confidence, language: ai.language, covered };\nif (listed && ai.confidence === 'high' && covered) {\n  return [{ json: { route: 'set', category: listed.name, queue: listed.queue, confidence: ai.confidence, rules } }];\n}\nconst reason = !covered ? 'language not covered' : !listed ? 'category not listed' : 'confidence not high';\nreturn [{ json: { route: 'exception', reason, detail: `AI suggested ${ai.category} (${ai.confidence}, ${ai.language})`, rules } }];\n"
      },
      "id": "d3376791-570d-5ee0-90a0-aa1a0abf06b2",
      "name": "Step 5: Rule: use the category?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        120
      ],
      "notes": "The rule decides, not the AI.",
      "notesInFlow": true
    },
