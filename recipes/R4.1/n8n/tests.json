{
  "config": {
    "helpdesk_url": "{mocks}/helpdesk",
    "categories": [
      {"name": "Delivery", "queue": "Delivery", "owner": "dispatch lead", "description": "Delivery dates, delivery slots and where an order is",
       "examples": ["When will my order arrive?", "Can you deliver on Saturday?", "The driver has not come"]},
      {"name": "Complaint", "queue": "Complaints", "owner": "customer service lead", "description": "Dissatisfaction with a product, a delivery or a person",
       "examples": ["The table arrived scratched", "Your driver was rude", "I am very unhappy with the installation"]},
      {"name": "Returns", "queue": "Returns", "owner": "returns lead", "description": "Returning or exchanging a product",
       "examples": ["How do I return this lamp?", "I want to exchange the sofa for another colour", "Can I get a refund?"]}
    ],
    "covered_languages": ["en"],
    "low_priority_queue": "Low priority",
    "triage_queue": "Manual triage",
    "triage_lead": "triage-lead@example.test",
    "bulk_senders": ["@newsletter.example.test"],
    "ai_url": "{mocks}/anthropic/v1/messages"
  },
  "seed": {"helpdesk": {"tickets": {
    "T-1": {"id": "T-1", "message_id": "M-1", "from": "customer@example.test", "subject": "Order 4417",
            "body": "When is my sofa arriving? Order 4417", "headers": {}}
  }}},
  "cases": [
    {"case": "Normal", "row": 1, "input": "\"When is my sofa arriving? Order 4417\"", "needs_ai": true,
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"mock": "helpdesk/tickets/T-1", "field": "queue", "equals": "Delivery"},
                {"sql": "select count(*) from exception_queue", "equals": "0"}]},
    {"case": "Edge", "row": 2, "input": "Return complaining about the driver", "needs_ai": true,
     "seed": {"helpdesk": {"tickets": {"T-1": {"subject": "Return", "body": "I want to send the bed back. Your driver dragged it up the stairs and was rude to my mother."}}}},
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"mock": "helpdesk/tickets/T-1", "field": "queue", "in": ["Complaints", "Manual triage"]}]},
    {"case": "Duplicate", "row": 3, "input": "Same message ID twice",
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}, "pause": 3},
                 {"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"calls": "PATCH /helpdesk/tickets/T-1", "count": 1},
                {"sql": "select copies_skipped from key_log where recipe='R4.1'", "equals": "1"}]},
    {"case": "Escalate", "row": 4, "input": "Uncovered language", "needs_ai": true,
     "seed": {"helpdesk": {"tickets": {"T-1": {"subject": "Pedido 4417", "body": "Hola, ¿cuándo llega mi sofá? Es el pedido 4417. Gracias."}}}},
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"mock": "helpdesk/tickets/T-1", "field": "queue", "equals": "Manual triage"},
                {"sql": "select reason from exception_queue where recipe='R4.1'", "equals": "needs manual triage"}]},
    {"case": "Automatic sender", "row": 5, "input": "An out-of-office reply (companion extension)",
     "seed": {"helpdesk": {"tickets": {"T-1": {"headers": {"Auto-Submitted": "auto-replied"}, "body": "I am out of the office until Monday."}}}},
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"mock": "helpdesk/tickets/T-1", "field": "queue", "equals": "Low priority"},
                {"calls": "POST /anthropic/v1/messages", "count": 0}]},
    {"case": "AI error", "row": 6, "input": "The AI call fails twice (companion extension)",
     "fail": [{"method": "POST", "path": "/anthropic/v1/messages", "status": 529, "times": 2}],
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"mock": "helpdesk/tickets/T-1", "field": "queue", "equals": "Manual triage"},
                {"calls": "POST /anthropic/v1/messages", "count": 2},
                {"sql": "select reason from exception_queue where recipe='R4.1'", "equals": "needs manual triage"}]},
    {"case": "Write fails", "row": 7, "input": "The routing write fails (companion extension)",
     "fail": [{"method": "POST", "path": "/anthropic/v1/messages", "status": 529, "times": 2},
              {"method": "PATCH", "path": "/helpdesk/tickets/T-1", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r4-1-new-message", "body": {"ticket_id": "T-1", "message_id": "M-1"}}],
     "expect": [{"calls": "PATCH /helpdesk/tickets/T-1", "count": 1},
                {"sql": "select status from key_log where recipe='R4.1'", "equals": "failed"},
                {"sql": "select reason from exception_queue where recipe='R4.1'", "equals": "write failed"}]}
  ]
}
