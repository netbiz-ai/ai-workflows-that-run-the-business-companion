{
  "config": {
    "requests_url": "{mocks}/sharepoint",
    "budget_url": "{mocks}/budget",
    "approvals_url": "{mocks}/approvals",
    "vendors_url": "{mocks}/vendors",
    "policy_url": "{mocks}/policy",
    "ledger_url": "{mocks}/ledger",
    "messaging_url": "{mocks}/messaging",
    "bill_tolerance": 50,
    "approver": "tom@example.test",
    "senior_approver": "helen@example.test",
    "payment_approver": "aisha@example.test",
    "budget_owner": "aisha@example.test",
    "buyer": "buyer@example.test",
    "editor": "owen@example.test"
  },
  "seed": {
    "sharepoint": {"requests": {
      "REQ-1": {"id": "REQ-1", "version": 1, "status": "checked; to approval", "requester": "requester@example.test",
                "supplier_id": "SUP-1", "budget_line": "BL-STORE", "category": "store fixtures", "amount": 3200, "total": 3200,
                "comparison": {"checked": true, "link": "https://sheet.example.test/rows/7"}, "waiver": null,
                "quote": {"matches": true, "valid_until": "{today+20}", "freight": "included"}}
    }},
    "budget": {"lines": {"BL-STORE": {"id": "BL-STORE", "budget": 20000, "spent": 11000, "export_date": "{today-1}"}}, "commitments": {}},
    "vendors": {"records": {"SUP-1": {"id": "SUP-1", "active": true, "hold": false}}},
    "policy": {"budget_lines": {"BL-STORE": {"id": "BL-STORE", "allowed_categories": ["store fixtures"], "waiver_grantors": ["Tom Rivera"]}}},
    "approvals": {"approvals": {}},
    "ledger": {"bills": {}}
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "$3,200, $9,000 left",
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "approvals/approvals/REQ-1-v1", "field": "approver", "equals": "tom@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "budget_before", "equals": 9000},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "budget_after", "equals": 5800},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "valid_until", "equals": "{today+20}"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "comparison_link", "equals": "https://sheet.example.test/rows/7"},
       {"mock": "messaging/messages", "count": 0},
       {"sql": "select status from key_log where recipe='R11.3'", "equals": "done"},
       {"sql": "select count(*) from decision_log where recipe='R11.3'", "equals": "1"}]},
    {"case": "Edge", "row": 2, "input": "Second $6,000 of a possible split; $8,000 left",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"amount": 6000, "total": 12000}}},
              "budget": {"lines": {"BL-STORE": {"spent": 12000}}}},
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "approvals/approvals/REQ-1-v1", "field": "approver", "equals": "helen@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "total", "equals": 12000},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "budget_before", "equals": 8000},
       {"mock": "messaging/messages", "count": 0}]},
    {"case": "Edge", "row": 3, "input": "Tom raises $4,000",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"requester": "tom@example.test", "amount": 4000, "total": 4000}}}},
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "approvals/approvals/REQ-1-v1", "field": "approver", "equals": "helen@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "standin", "equals": null}]},
    {"case": "Duplicate", "row": 4, "input": "Status set twice",
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}, "pause": 2},
                 {"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"calls": "POST /approvals/approvals", "count": 1},
       {"mock": "approvals/approvals", "count": 1},
       {"sql": "select copies_skipped from key_log where recipe='R11.3'", "equals": "1"}]},
    {"case": "Refuse", "row": 5, "input": "Helen approves after the quote expired",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"amount": 12000, "total": 12000,
                                                    "quote": {"matches": true, "valid_until": "{today-1}", "freight": "included"}}}},
              "approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "helen@example.test", "standin": "tom@example.test", "requester": "requester@example.test",
                                                        "amount": 12000, "total": 12000, "valid_until": "{today-1}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": -3000, "remind_on": "{today+2}", "standin_on": "{today+3}"}}}},
     "trigger": [{"webhook": "r11-3-approval-answered", "body": {"approval_id": "REQ-1-v1", "decision": "approved", "by": "helen@example.test"}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "blocked"},
       {"mock": "sharepoint/requests/REQ-1", "field": "reasons", "contains": "quote expired during approval"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "status", "equals": "approved"},
       {"calls": "POST /budget/commitments", "count": 0},
       {"mock": "messaging/messages/1", "field": "to", "equals": "requester@example.test"}]},
    {"case": "Refuse", "row": 6, "input": "Requester edits after release",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"version": 2, "locked": true, "approved_version": 1, "approved_by": "tom@example.test"}}}},
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 2}}],
     "expect": [
       {"calls": "POST /approvals/approvals", "count": 0},
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "approved"},
       {"mock": "sharepoint/requests/REQ-1", "field": "edit_refused", "equals": "new request needed"},
       {"mock": "messaging/messages/1", "field": "text", "contains": "Raise a new request"}]},
    {"case": "Over budget", "row": 7, "input": "$9,500 with $9,000 left (companion extension)",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"amount": 9500, "total": 9500}}}},
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "approvals/approvals/REQ-1-v1", "field": "approver", "equals": "helen@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "budget_after", "equals": -500},
       {"mock": "messaging/messages", "count": 1},
       {"mock": "messaging", "field": "messages", "contains": "\"to\": \"aisha@example.test\""}]},
    {"case": "Stale export", "row": 8, "input": "Budget export eight days old (companion extension)",
     "seed": {"budget": {"lines": {"BL-STORE": {"export_date": "{today-8}"}}}},
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"calls": "POST /approvals/approvals", "count": 0},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R11.3'", "equals": "budget export stale / aisha@example.test"},
       {"mock": "messaging/messages/1", "field": "to", "equals": "aisha@example.test"},
       {"sql": "select count(*) from key_log where recipe='R11.3'", "equals": "0"}]},
    {"case": "Release", "row": 9, "input": "Tom approves; quote valid, supplier clear (companion extension)",
     "seed": {"approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "tom@example.test", "standin": "helen@example.test", "requester": "requester@example.test",
                                                        "amount": 3200, "total": 3200, "valid_until": "{today+20}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": 5800, "remind_on": "{today+2}", "standin_on": "{today+3}"}}}},
     "trigger": [{"webhook": "r11-3-approval-answered", "body": {"approval_id": "REQ-1-v1", "decision": "approved", "by": "tom@example.test"}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "approved"},
       {"mock": "sharepoint/requests/REQ-1", "field": "locked", "equals": true},
       {"mock": "budget/commitments/REQ-1", "field": "remaining", "equals": 3200},
       {"mock": "messaging", "field": "messages", "contains": "\"to\": \"buyer@example.test\""},
       {"sql": "select count(*) from decision_log where recipe='R11.3' and decision='approved'", "equals": "1"}]},
    {"case": "Rejected", "row": 10, "input": "Tom rejects with a comment (companion extension)",
     "seed": {"approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "tom@example.test", "standin": "helen@example.test", "requester": "requester@example.test",
                                                        "amount": 3200, "total": 3200, "valid_until": "{today+20}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": 5800, "remind_on": "{today+2}", "standin_on": "{today+3}"}}}},
     "trigger": [{"webhook": "r11-3-approval-answered", "body": {"approval_id": "REQ-1-v1", "decision": "rejected", "by": "tom@example.test", "comment": "Use the stocked shelf unit"}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "rejected"},
       {"mock": "sharepoint/requests/REQ-1", "field": "rejection_comment", "equals": "Use the stocked shelf unit"},
       {"calls": "POST /budget/commitments", "count": 0}]},
    {"case": "Reminder", "row": 11, "input": "No answer in two working days; quote valid until tomorrow (companion extension)",
     "seed": {"approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "tom@example.test", "standin": "helen@example.test", "requester": "requester@example.test",
                                                        "amount": 3200, "total": 3200, "valid_until": "{today+1}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": 5800, "remind_on": "{today}", "standin_on": "{today+1}"}}}},
     "trigger": [{"schedule": "Steps 7 and 8: Each morning"}],
     "expect": [
       {"mock": "messaging/messages", "count": 2},
       {"mock": "messaging/messages/1", "field": "to", "equals": "tom@example.test"},
       {"mock": "messaging/messages/2", "field": "to", "equals": "requester@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "reminded", "equals": true}]},
    {"case": "Stand-in", "row": 12, "input": "No answer in three working days (companion extension)",
     "seed": {"approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "tom@example.test", "standin": "helen@example.test", "requester": "requester@example.test",
                                                        "amount": 3200, "total": 3200, "valid_until": "{today+20}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": 5800, "reminded": true, "remind_on": "{today-1}", "standin_on": "{today}"}}}},
     "trigger": [{"schedule": "Steps 7 and 8: Each morning"}],
     "expect": [
       {"mock": "approvals/approvals/REQ-1-v1", "field": "approver", "equals": "helen@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "escalated", "equals": true},
       {"mock": "messaging/messages", "count": 1},
       {"mock": "messaging/messages/1", "field": "to", "equals": "helen@example.test"}]},
    {"case": "Approver and stand-in away", "row": 13, "input": "No answer after the stand-in (companion extension)",
     "seed": {"approvals": {"approvals": {"REQ-1-v1": {"id": "REQ-1-v1", "request_id": "REQ-1", "version": 1, "status": "open",
                                                        "approver": "helen@example.test", "standin": null, "requester": "requester@example.test",
                                                        "amount": 3200, "total": 3200, "valid_until": "{today+20}", "waiver": false, "budget_line": "BL-STORE",
                                                        "budget_before": 9000, "budget_after": 5800, "reminded": true, "escalated": true,
                                                        "remind_on": "{today-4}", "standin_on": "{today-3}", "final_on": "{today}"}}}},
     "trigger": [{"schedule": "Steps 7 and 8: Each morning"}],
     "expect": [
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R11.3'", "equals": "no answer after the stand-in / helen@example.test"},
       {"mock": "approvals/approvals/REQ-1-v1", "field": "final_sent", "equals": true},
       {"mock": "messaging/messages/1", "field": "to", "equals": "helen@example.test"}]},
    {"case": "Bill over commitment", "row": 14, "input": "A $3,400 bill on a $3,200 commitment, tolerance $50 (companion extension)",
     "seed": {"budget": {"commitments": {
                "REQ-1": {"id": "REQ-1", "request_id": "REQ-1", "budget_line": "BL-STORE", "amount": 3200, "billed": 0, "remaining": 3200},
                "REQ-2": {"id": "REQ-2", "request_id": "REQ-2", "budget_line": "BL-STORE", "amount": 1000, "billed": 0, "remaining": 1000}}},
              "ledger": {"bills": {
                "B-1": {"id": "B-1", "request_id": "REQ-1", "amount": 3400},
                "B-2": {"id": "B-2", "request_id": "REQ-2", "amount": 600},
                "B-3": {"id": "B-3", "request_id": null, "amount": 80}}}},
     "trigger": [{"webhook": "r11-3-new-export", "body": {"export_date": "{today}"}, "pause": 2},
                 {"webhook": "r11-3-new-export", "body": {"export_date": "{today}"}}],
     "expect": [
       {"mock": "budget/commitments/REQ-1", "field": "remaining", "equals": 0},
       {"mock": "budget/commitments/REQ-2", "field": "remaining", "equals": 400},
       {"mock": "budget/commitments/REQ-2", "field": "billed", "equals": 600},
       {"sql": "select reason || ' / ' || owner || ' / ' || item from exception_queue where recipe='R11.3'", "equals": "bill over commitment / aisha@example.test / REQ-1"},
       {"sql": "select string_agg(status, ',' order by key) from key_log where recipe='R11.3'", "equals": "done,done"},
       {"mock": "messaging/messages", "count": 1}]},
    {"case": "Write fails", "row": 15, "input": "The approval write fails (companion extension)",
     "fail": [{"method": "POST", "path": "/approvals/approvals", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r11-3-to-approval", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"calls": "POST /approvals/approvals", "count": 1},
       {"sql": "select status from key_log where recipe='R11.3'", "equals": "failed"},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R11.3'", "equals": "write failed / owen@example.test"}]}
  ]
}
