          "y": 0,
          "name": "Stop flag: read"
        }
      },
      "onerror": [
        {
          "id": 3,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {},
          "mapper": {
            "url": "{{2.result.table_api_url}}/exception_queue",
            "method": "post",
            "timeout": "40",
            "parseResponse": false,
            "stopOnHttpError": true,
            "allowRedirects": true,
            "shareCookies": false,
            "requestCompressedContent": true,
            "contentType": "json",
            "inputMethod": "jsonString",
            "jsonStringBodyContent": "{\"recipe\": \"R15.1\", \"item\": \"run {{var.scenario.executionId}}\", \"reason\": \"stop list unreadable\", \"detail\": \"The stop list could not be read, so the run stopped\", \"owner\": \"{{2.result.workflow_owner}}\"}"
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Stop flag: list unreadable"
            }
          }
        },
        {
          "id": 4,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 900,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.drafts_url}}/versions/{{encodeURL(1.version_id)}}",
        "method": "get",
        "timeout": "40",
        "parseResponse": true,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Read the version Ben approves"
        }
      },
      "onerror": [
        {
          "id": 6,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "count": "3",
            "retry": true,
            "interval": "1"
          },
          "metadata": {
            "designer": {
              "x": 900,
              "y": 600
            }
          }
        }
      ],
      "filter": {
        "name": "stop flag not set",
        "conditions": [
          [
            {
              "a": "{{5.data.stopped}}",
              "b": "true",
              "o": "text:notequal"
            }
          ]
        ]
      }
    },
    {
      "id": 8,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 9: Fingerprint the approved text\": \"in1_Step9Fingerprinttheappro\", \"Read the version Ben approves\": \"in2_ReadtheversionBenapprove\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read the version Ben approves\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 9: Ben approves').first().json.body.\nDATA[\"Step 9: Ben approves\"] = [{ json: { body: { \"version_id\": input.t_version_id } } }];\nconst BODIES = (out) => ({\"id_q\": encodeURIComponent(out.version_id), \"store_body\": JSON.stringify({ status: 'approved; ready to send', fingerprint: $('Step 9: Fingerprint the approved text').first().json.fingerprint, approved_at: new Date().toISOString() }), \"report_body\": JSON.stringify({ version_id: out.version_id, step: 9, result: 'approved by Ben', fingerprint: $('Step 9: Fingerprint the approved text').first().json.fingerprint, approvals: $('Read the version Ben approves').first().json.approvals, at: new Date().toISOString() }), \"log_body\": JSON.stringify({ recipe: 'R15.1', item: out.version_id, decision: out.decision, rules: {} }), \"failed_body\": JSON.stringify({ recipe: 'R15.1', item: String($('Step 9: Ben approves').first().json.body.version_id), reason: 'write failed', detail: 'write failed; never retried', owner: $('Config').first().json.ai_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 9: Ben approves only a version every named approver has signed.\nconst v = $json;\nconst ok = v.status === 'waiting for Ben';\nreturn [{ json: { version_id: v.id, ok, text: v.text, decision: ok ? 'approved by Ben' : `Ben's approval not recorded: version is ${v.status}` } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "t_version_id",
            "value": "{{1.version_id}}"
          },
          {
            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_Step9Fingerprinttheappro",
            "value": "{\"fingerprint\": \"{{sha256(7.data.text)}}\"}"
          },
          {
            "name": "in2_ReadtheversionBenapprove",
            "value": "{{7.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Step 9: Rule: every approver signed?"
        }
      }
    },
