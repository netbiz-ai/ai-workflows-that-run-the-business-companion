        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Step 9: Ben approves"
        }
      }
    },
    {
      "id": 2,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R15.1\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"briefs_url\": \"https://<your brief list API>\",\n  \"claims_url\": \"https://<your claims list API>\",\n  \"prices_url\": \"https://<your CRM price list API>\",\n  \"style_sheet_url\": \"https://<your style sheet API>\",\n  \"drafts_url\": \"https://<your drafts and claims report API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"approvers\": {\n    \"price\": \"<your price approver>\",\n    \"time\": \"<your delivery and installation approver>\",\n    \"warranty\": \"<your warranty approver>\",\n    \"comparison\": \"<your comparison approver>\",\n    \"environmental\": \"<your environmental claim approver>\"\n  },\n  \"final_approver\": \"<your campaign owner>\",\n  \"ai_owner\": \"<your workflow builder>\",\n  \"stand_in_namer\": \"<your workflow owner>\",\n  \"signoff_wait_days\": 2,\n  \"scan_words\": [\n    \"free\",\n    \"warranty\",\n    \"guarantee\",\n    \"best\",\n    \"today\",\n    \"tonight\",\n    \"tomorrow\",\n    \"day\",\n    \"days\",\n    \"week\",\n    \"weeks\",\n    \"weekend\",\n    \"month\",\n    \"hour\",\n    \"hours\",\n    \"monday\",\n    \"tuesday\",\n    \"wednesday\",\n    \"thursday\",\n    \"friday\",\n    \"saturday\",\n    \"sunday\"\n  ],\n  \"prompt_version\": \"<your prompt version>\",\n  \"ai_model\": \"claude-haiku-5-5\",\n  \"ai_inference_geo\": \"us\",\n  \"ai_url\": \"https://api.anthropic.com/v1/messages\"\n};",
        "input": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Config"
        }
      }
    },
    {
      "id": 5,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.stop_flag_url}}",
        "method": "get",
        "timeout": "40",
        "parseResponse": true,
        "stopOnHttpError": true,
        "allowRedirects": true,
