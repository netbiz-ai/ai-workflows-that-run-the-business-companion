            "contentType": "json",
            "inputMethod": "jsonString",
            "jsonStringBodyContent": "{\"recipe\": \"R15.1\", \"item\": \"run {{var.scenario.executionId}}\", \"reason\": \"stop list unreadable\", \"detail\": \"The stop list could not be read, so the run stopped\", \"owner\": \"{{2.result.workflow_owner}}\"}"
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Stop flag: list unreadable"
            }
          }
        },
        {
          "id": 4,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 900,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 7,
