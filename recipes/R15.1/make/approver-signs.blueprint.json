    {
      "id": 8,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Read the version to sign\": \"in1_Readtheversiontosign\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read the version to sign\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 8: Approver signs').first().json.body.\nDATA[\"Step 8: Approver signs\"] = [{ json: { body: { \"version_id\": input.t_version_id, \"approver\": input.t_approver, \"decision\": input.t_decision } } }];\nconst BODIES = (out) => ({\"id_q\": encodeURIComponent(out.version_id), \"patch_body\": JSON.stringify(out.body), \"has_message\": !!out.message, \"message_body\": out.message ? JSON.stringify(out.message) : '', \"log_body\": JSON.stringify({ recipe: 'R15.1', item: out.version_id, decision: out.decision, rules: {} }), \"failed_body\": JSON.stringify({ recipe: 'R15.1', item: String($('Step 8: Approver signs').first().json.body.version_id), reason: 'write failed', detail: 'write failed; never retried', owner: $('Config').first().json.ai_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 8: a named approver signs or strikes; when every one has signed, Ben is asked (step 9).\nconst cfg = $('Config').first().json;\nconst b = $('Step 8: Approver signs').first().json.body;\nconst v = $json;\nconst a = JSON.parse(JSON.stringify(v.approvals || {}));\nif (v.status !== 'waiting for sign-off' || !a[b.approver]) {\n  return [{ json: { version_id: v.id, record: false, message: null,\n    decision: 'sign-off ignored: ' + (!a[b.approver] ? 'not a named approver for this version' : 'version is ' + v.status) } }];\n}\na[b.approver].status = b.decision === 'struck' ? 'struck' : 'signed';\na[b.approver].at = new Date().toISOString();\nlet status = 'waiting for sign-off', message = null;\nif (b.decision === 'struck') {\n  status = 'returned to Ben';\n  message = { to: [cfg.final_approver], subject: `Campaign copy ${v.id} returned`, text: `${b.approver} struck: ${a[b.approver].claims.join(', ')}` };\n} else if (Object.values(a).every(x => x.status === 'signed')) {\n  status = 'waiting for Ben';\n  message = { to: [cfg.final_approver], subject: `Campaign copy ${v.id}: every approver signed`, text: 'Read the final copy and approve.\\n\\n' + v.text };\n}\nreturn [{ json: { version_id: v.id, record: true, body: { approvals: a, status }, message, decision: `${b.approver} ${a[b.approver].status}; ${status}` } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "t_version_id",
            "value": "{{1.version_id}}"
          },
          {
            "name": "t_approver",
            "value": "{{1.approver}}"
          },
          {
            "name": "t_decision",
            "value": "{{1.decision}}"
          },
          {
            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_Readtheversiontosign",
            "value": "{{7.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Step 8: Rule: record the sign-off"
        }
      }
