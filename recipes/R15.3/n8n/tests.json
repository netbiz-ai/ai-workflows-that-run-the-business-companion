{
  "config": {
    "crm_url": "{mocks}/crm",
    "lists": [
      {"name": "shop", "url": "http://mocks:8080/shop", "channel": "email"},
      {"name": "pos", "url": "http://mocks:8080/pos", "channel": "email"},
      {"name": "helpdesk", "url": "http://mocks:8080/helpdesk", "channel": "email"}
    ],
    "marketing_channels": ["email", "sms"],
    "send_status_url": "{mocks}/sendstatus",
    "messaging_url": "{mocks}/messaging",
    "consent_owner": "owen@example.test"
  },
  "seed": {
    "crm": {"contacts": {
      "C-1": {"id": "C-1", "name": "Jane Doe", "email": "jane@example.test", "phone": "+15550100",
              "consent": {"email": {"status": "opted in", "at": "{today-30}T10:00:00Z", "wording_version": "v2"},
                          "sms": {"status": "opted in", "at": "{today-30}T10:00:00Z", "wording_version": "v2"}}}
    }},
    "shop": {"contacts": {
      "S-1": {"id": "S-1", "name": "Jane Doe", "email": "jane@example.test", "phone": null, "marketing_opt_out": false},
      "S-2": {"id": "S-2", "name": "Jane Doe", "email": "other@example.test", "phone": null, "marketing_opt_out": false}
    }},
    "pos": {"contacts": {
      "P-1": {"id": "P-1", "name": "J. Doe", "email": null, "phone": "+15550100", "marketing_opt_out": false}
    }},
    "helpdesk": {"contacts": {
      "H-1": {"id": "H-1", "name": "Jane", "email": "jane@example.test", "phone": "+15550100", "marketing_opt_out": false}
    }}
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "Unsubscribe clicked",
     "trigger": [{"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"email\": {\"status\": \"opted out\""},
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"sms\": {\"status\": \"opted out\""},
       {"mock": "shop/contacts/S-1", "field": "marketing_opt_out", "equals": true},
       {"mock": "pos/contacts/P-1", "field": "marketing_opt_out", "equals": true},
       {"mock": "helpdesk/contacts/H-1", "field": "marketing_opt_out", "equals": true},
       {"mock": "shop/contacts/S-2", "field": "marketing_opt_out", "equals": false},
       {"calls": "GET /shop/contacts/S-1", "count": 1},
       {"calls": "GET /pos/contacts/P-1", "count": 1},
       {"calls": "GET /helpdesk/contacts/H-1", "count": 1},
       {"sql": "select count(*) from decision_log where recipe='R15.3' and decision like '%: confirmed'", "equals": "3"},
       {"sql": "select count(*) from exception_queue", "equals": "0"}]},
    {"case": "Edge", "row": 2, "input": "Older opt-in arrives late",
     "seed": {"crm": {"contacts": {"C-1": {"consent": {"email": {"status": "opted out", "at": "{today}T09:00:00Z", "event_id": "E-1"},
                                                       "sms": {"status": "opted out", "at": "{today}T09:00:00Z", "event_id": "E-1"}}}}},
              "shop": {"contacts": {"S-1": {"marketing_opt_out": true}}}},
     "trigger": [{"webhook": "r15-3-opt-in", "body": {"event_id": "E-2", "email": "jane@example.test", "channel": "email",
                                                       "wording_version": "v3", "occurred_at": "{today-1}T10:00:00Z"}}],
     "expect": [
       {"calls": "PATCH /crm/contacts/C-1", "count": 0},
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"email\": {\"status\": \"opted out\""},
       {"calls": "PATCH /shop/contacts/S-1", "count": 0},
       {"mock": "shop/contacts/S-1", "field": "marketing_opt_out", "equals": true},
       {"sql": "select decision from decision_log where recipe='R15.3'", "equals": "ignored: opt-in older than an opt-out"}]},
    {"case": "Duplicate", "row": 3, "input": "Same unsubscribe twice",
     "trigger": [{"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}, "pause": 3},
                 {"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"calls": "PATCH /crm/contacts/C-1", "count": 1},
       {"calls": "PATCH /shop/contacts/S-1", "count": 1},
       {"sql": "select copies_skipped from key_log where recipe='R15.3'", "equals": "1"}]},
    {"case": "Escalate", "row": 4, "input": "Shop's API down",
     "fail": [{"method": "GET", "path": "/shop", "status": 503, "times": 10},
              {"method": "POST", "path": "/shop", "status": 503, "times": 5},
              {"method": "PATCH", "path": "/shop", "status": 503, "times": 5}],
     "trigger": [{"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"mock": "sendstatus/lists/shop", "field": "status", "equals": "paused"},
       {"calls": "POST /shop/suppressions", "count": 1},
       {"mock": "pos/contacts/P-1", "field": "marketing_opt_out", "equals": true},
       {"mock": "helpdesk/contacts/H-1", "field": "marketing_opt_out", "equals": true},
       {"sql": "select count(*) from exception_queue where recipe='R15.3' and reason='list did not confirm' and detail like 'shop: list unreachable%; list paused'", "equals": "1"},
       {"mock": "messaging/messages/1", "field": "to", "equals": "owen@example.test"}]},
    {"case": "Opt-in without proof", "row": 5, "input": "An opt-in with no wording version (companion extension)",
     "trigger": [{"webhook": "r15-3-opt-in", "body": {"event_id": "E-3", "email": "jane@example.test", "channel": "email", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"calls": "PATCH /crm/contacts/C-1", "count": 0},
       {"calls": "PATCH /shop/contacts/S-1", "count": 0},
       {"sql": "select decision from decision_log where recipe='R15.3'", "equals": "ignored: opt-in without wording version or time stamp"}]},
    {"case": "Read-back fails", "row": 6, "input": "Shop takes the write; its read-back fails (companion extension)",
     "fail": [{"method": "GET", "path": "/shop/contacts/S-1", "status": 503, "times": 3}],
     "trigger": [{"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"calls": "PATCH /shop/contacts/S-1", "count": 1},
       {"mock": "shop/suppressions", "count": 1},
       {"mock": "sendstatus/lists", "count": 0},
       {"sql": "select reason from exception_queue where recipe='R15.3'", "equals": "list did not confirm"},
       {"mock": "messaging/messages", "count": 1}]},
    {"case": "Master write fails", "row": 7, "input": "The CRM consent write fails (companion extension)",
     "fail": [{"method": "PATCH", "path": "/crm/contacts/C-1", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r15-3-unsubscribe", "body": {"event_id": "E-1", "email": "jane@example.test", "occurred_at": "{today}T10:00:00Z"}}],
     "expect": [
       {"calls": "PATCH /crm/contacts/C-1", "count": 1},
       {"calls": "PATCH /shop/contacts/S-1", "count": 0},
       {"sql": "select status from key_log where recipe='R15.3'", "equals": "failed"},
       {"sql": "select reason from exception_queue where recipe='R15.3'", "equals": "write failed"},
       {"mock": "messaging/messages", "count": 1}]},
    {"case": "POS sign-up", "row": 8, "input": "POS sign-up with wording version, newer than the opt-out (companion extension)",
     "seed": {"crm": {"contacts": {"C-1": {"consent": {"email": {"status": "opted out", "at": "{today-10}T09:00:00Z"},
                                                       "sms": {"status": "opted out", "at": "{today-10}T09:00:00Z"}}}}},
              "shop": {"contacts": {"S-1": {"marketing_opt_out": true}}},
              "pos": {"contacts": {"P-1": {"marketing_opt_out": true}}},
              "helpdesk": {"contacts": {"H-1": {"marketing_opt_out": true}}}},
     "trigger": [{"webhook": "r15-3-pos-signup", "body": {"event_id": "E-4", "email": "jane@example.test", "phone": "+15550100", "channel": "email",
                                                           "wording_version": "v3", "occurred_at": "{today}T11:00:00Z"}}],
     "expect": [
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"email\": {\"status\": \"opted in\""},
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"wording_version\": \"v3\""},
       {"mock": "crm/contacts/C-1", "field": "consent", "contains": "\"sms\": {\"status\": \"opted out\""},
       {"mock": "shop/contacts/S-1", "field": "marketing_opt_out", "equals": false},
       {"mock": "pos/contacts/P-1", "field": "marketing_opt_out", "equals": false},
       {"sql": "select count(*) from exception_queue", "equals": "0"}]},
    {"case": "Nightly drift", "row": 9, "input": "Shop still subscribed after the master opted out (companion extension)",
     "seed": {"crm": {"contacts": {"C-1": {"consent": {"email": {"status": "opted out", "at": "{today-1}T09:00:00Z"},
                                                       "sms": {"status": "opted out", "at": "{today-1}T09:00:00Z"}}}}},
              "pos": {"contacts": {"P-1": {"marketing_opt_out": true}}},
              "helpdesk": {"contacts": {"H-1": {"marketing_opt_out": true}}}},
     "trigger": [{"schedule": "Step 8: Each night"}],
     "expect": [
       {"mock": "shop/contacts/S-1", "field": "marketing_opt_out", "equals": true},
       {"mock": "shop/contacts/S-2", "field": "marketing_opt_out", "equals": false},
       {"calls": "PATCH /pos/contacts/P-1", "count": 0},
       {"calls": "PATCH /shop/contacts/S-2", "count": 0},
       {"sql": "select decision from decision_log where recipe='R15.3'", "equals": "nightly: shop corrected to the master"}]},
    {"case": "Write still failing", "row": 10, "input": "Shop still down at the nightly check (companion extension)",
     "fail": [{"method": "GET", "path": "/shop", "status": 503, "times": 10}],
     "trigger": [{"schedule": "Step 8: Each night"}],
     "expect": [
       {"sql": "select reason from exception_queue where recipe='R15.3'", "equals": "nightly check failed"},
       {"mock": "messaging/messages/1", "field": "to", "equals": "owen@example.test"}]}
  ]
}
