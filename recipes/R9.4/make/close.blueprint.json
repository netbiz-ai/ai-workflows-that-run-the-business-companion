            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_Step9Readthecase",
            "value": "{{7.data}}"
          },
          {
            "name": "in2_Step9Readitsevidence",
            "value": "{{9.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
