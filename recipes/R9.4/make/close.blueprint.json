      "id": 10,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 9: Read the case\": \"in1_Step9Readthecase\", \"Step 9: Read its evidence\": \"in2_Step9Readitsevidence\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 9: Read its evidence\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 9: Owen closes the case').first().json.body.\nDATA[\"Step 9: Owen closes the case\"] = [{ json: { body: { \"case_id\": input.t_case_id, \"by\": input.t_by } } }];\nconst BODIES = (out) => ({\"case_q\": encodeURIComponent(out.case_id), \"key_q\": encodeURIComponent(out.key || ''), \"close_body\": JSON.stringify({ status: 'closed', closed_by: out.by, closed_at: new Date().toISOString() }), \"done_body\": JSON.stringify({ status: 'done', result: 'closed by ' + out.by }), \"log_body\": JSON.stringify({ recipe: 'R9.4', item: out.case_id, decision: 'closed', rules: { closed_by: out.by } }), \"refused_message\": JSON.stringify({ to: $('Config').first().json.access_owner, subject: 'Case ' + out.case_id + ' not closed', text: out.why })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 9: only the access owner closes, and never with an item unconfirmed.\nconst cfg = $('Config').first().json;\nconst b = $('Step 9: Owen closes the case').first().json.body;\nconst c = ($('Step 9: Read the case').first().json.items || [])[0];\nconst evidence = $('Step 9: Read its evidence').first().json.items || [];\nconst confirmed = new Set(evidence.filter(e => e.status === 'confirmed').map(e => e.item_id));\nlet why = '';\nif (!c) why = 'no such case';\nelse if (String(b.by || '').toLowerCase() !== String(cfg.access_owner).toLowerCase()) why = 'only the access owner closes a case';\nelse if (c.status === 'closed') why = 'already closed';\nelse if (!(c.items || []).length || !(c.items || []).every(i => confirmed.has(i))) why = 'items unconfirmed: ' + (c.items || []).filter(i => !confirmed.has(i)).join(', ');\nreturn [{ json: { ok: !why, why, case_id: b.case_id, key: c && c.key, by: b.by } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "t_case_id",
            "value": "{{1.case_id}}"
          },
          {
            "name": "t_by",
            "value": "{{1.by}}"
          },
