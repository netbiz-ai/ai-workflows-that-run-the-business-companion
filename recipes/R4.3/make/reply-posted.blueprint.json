            {
              "id": 13,
              "module": "code:ExecuteCode",
              "version": 1,
              "parameters": {},
              "mapper": {
                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Was there a draft?\": \"in1_Wasthereadraft\", \"Step 8: Read the draft note\": \"in2_Step8Readthedraftnote\", \"Step 8: Read the reply\": \"in3_Step8Readthereply\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 8: Read the reply\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 8: Reply posted').first().json.body.\nDATA[\"Step 8: Reply posted\"] = [{ json: { body: { \"ticket_id\": input.t_ticket_id, \"reply_id\": input.t_reply_id } } }];\nconst BODIES = (out) => ({\"log_body\": JSON.stringify({ recipe: 'R4.3', item: $('Step 8: Reply posted').first().json.body.ticket_id, decision: 'draft ' + out.outcome, rules: { reply_id: $('Step 8: Reply posted').first().json.body.reply_id, note_id: $('Was there a draft?').first().json.note_id, words_kept: out.share } })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 8: compare the posted reply with the saved draft: unchanged, edited or discarded.\nconst cfg = $('Config').first().json;\nconst norm = s => String(s || '').replace(/\\n\\nSources:.*$/s, '').replace(/\\[[^\\]\\n]+\\]/g, ' ').replace(/\\s+/g, ' ').trim().toLowerCase();\nconst draft = norm($('Step 8: Read the draft note').first().json.text);\nconst reply = norm($('Step 8: Read the reply').first().json.text);\nconst words = draft.split(' ').filter(Boolean);\nconst inReply = new Set(reply.split(' '));\nconst share = words.length ? words.filter(w => inReply.has(w)).length / words.length : 0;\nconst outcome = draft === reply ? 'unchanged' : share >= cfg.edited_min_share ? 'edited' : 'discarded';\nreturn [{ json: { outcome, share: Math.round(share * 100) / 100 } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
                "input": [
                  {
                    "name": "t_ticket_id",
                    "value": "{{1.ticket_id}}"
                  },
                  {
                    "name": "t_reply_id",
                    "value": "{{1.reply_id}}"
                  },
                  {
                    "name": "in0_Config",
                    "value": "{{2.result}}"
                  },
                  {
                    "name": "in1_Wasthereadraft",
                    "value": "{{8.data[1].rules}}"
                  },
                  {
                    "name": "in2_Step8Readthedraftnote",
                    "value": "{{10.data}}"
                  },
                  {
                    "name": "in3_Step8Readthereply",
                    "value": "{{12.data}}"
                  },
                  {
                    "name": "run_id",
                    "value": "{{var.scenario.executionId}}"
                  }
                ]
              },
