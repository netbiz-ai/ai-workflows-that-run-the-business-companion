        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R4.3\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"helpdesk_url\": \"https://<your helpdesk API>\",\n  \"articles_url\": \"https://<your knowledge base API>\",\n  \"orders_url\": \"https://<your order system API>\",\n  \"draft_queues\": [\n    {\n      \"queue\": \"<your warranty queue>\",\n      \"article_topic\": \"warranty\",\n      \"order\": false\n    },\n    {\n      \"queue\": \"<your returns queue>\",\n      \"article_topic\": \"returns\",\n      \"order\": true\n    },\n    {\n      \"queue\": \"<your delivery queue>\",\n      \"article_topic\": null,\n      \"order\": true\n    }\n  ],\n  \"r42_recheck_seconds\": 300,\n  \"r42_rechecks\": 3,\n  \"commitment_words\": [\n    \"free\",\n    \"refund\",\n    \"replace\",\n    \"credit\",\n    \"visit\"\n  ],\n  \"claim_words\": [\n    \"<your policy words, such as warranty, return, price>\"\n  ],\n  \"edited_min_share\": 0.5,\n  \"flag_owner\": \"<your draft owner>\",\n  \"ai_model\": \"claude-haiku-5-5\",\n  \"ai_inference_geo\": \"us\",\n  \"ai_url\": \"https://api.anthropic.com/v1/messages\"\n};",
        "input": []
