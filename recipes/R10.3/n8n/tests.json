  "cases": [
    {
      "case": "Normal",
      "row": 1,
      "input": "14 jobs, one overdue, one open complaint",
      "needs_ai": true,
      "trigger": [
        {
          "schedule": "Step 1: Each working afternoon"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "kind",
          "equals": "full"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "J-01:"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "J-14:"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "Risks (unchecked):"
        },
        {
          "mock": "budget/days/{today}",
          "field": "full_briefing_posted",
          "equals": true
        }
      ]
    },
    {
      "case": "Edge",
      "row": 2,
      "input": "Scheduling system down",
      "fail": [
        {
          "method": "GET",
          "path": "/scheduling/work_orders",
          "status": 503,
          "times": 2
        }
      ],
      "trigger": [
        {
          "schedule": "Step 1: Each working afternoon",
          "pause": 4
        },
        {
          "schedule": "Step 1: Second start"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "Partial dispatch briefing"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "Sources not available: work orders"
        },
        {
          "mock": "messaging/messages/briefing-{today}-2",
          "field": "kind",
          "equals": "partial"
        },
        {
          "calls": "GET /scheduling/work_orders",
          "count": 2
        },
        {
          "mock": "budget/days/{today}",
          "field": "starts",
          "equals": 2
        },
        {
          "mock": "budget/days/{today}",
          "field": "full_briefing_posted",
          "equals": false
        }
      ]
    },
    {
      "case": "Duplicate",
      "row": 3,
      "input": "Schedule fires again after a full briefing",
      "seed": {
        "budget": {
          "days": {
            "{today}": {
              "id": "{today}",
              "starts": 1,
              "full_briefing_posted": true,
              "ai_spend": 0.01
            }
          }
        }
      },
      "trigger": [
        {
          "schedule": "Step 1: Second start"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages",
          "count": 0
        },
        {
          "calls": "GET /scheduling/work_orders",
          "count": 0
        },
        {
          "calls": "POST /anthropic/v1/messages",
          "count": 0
        },
        {
          "calls": "PUT /budget/days/{today}",
          "count": 0
        }
      ]
    },
    {
      "case": "Refuse",
      "row": 4,
      "input": "Monthly AI cap reached",
      "seed": {
        "budget": {
          "days": {
            "{today}": {
              "id": "{today}",
              "starts": 0,
              "full_briefing_posted": false,
              "ai_spend": 70
            }
          }
        }
      },
      "trigger": [
        {
          "schedule": "Step 1: Each working afternoon"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages",
          "count": 1
        },
        {
          "mock": "messaging/messages/1",
          "field": "to",
          "equals": "owen@example.test"
        },
        {
          "calls": "GET /scheduling/work_orders",
          "count": 0
        },
        {
          "calls": "POST /anthropic/v1/messages",
          "count": 0
        },
        {
          "calls": "PUT /budget/days/{today}",
          "count": 0
        }
      ]
    },
    {
      "case": "AI error",
      "row": 5,
      "input": "The AI call fails (companion extension)",
      "fail": [
        {
          "method": "POST",
          "path": "/anthropic/v1/messages",
          "status": 529,
          "times": 1
        }
      ],
      "trigger": [
        {
          "schedule": "Step 1: Each working afternoon"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "kind",
          "equals": "partial"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "Why partial: AI error"
        },
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "J-14 | "
        },
        {
          "calls": "POST /anthropic/v1/messages",
          "count": 1
        },
        {
          "mock": "budget/days/{today}",
          "field": "ai_spend",
          "equals": 0
        },
        {
          "mock": "budget/days/{today}",
          "field": "full_briefing_posted",
          "equals": false
        }
      ]
    },
    {
      "case": "Source credential expires",
      "row": 6,
      "input": "The stock-exception read is refused on both starts (companion extension)",
      "fail": [
        {
          "method": "GET",
          "path": "/stock/exceptions",
          "status": 401,
          "times": 2
        }
      ],
      "trigger": [
        {
          "schedule": "Step 1: Each working afternoon",
          "pause": 4
        },
        {
          "schedule": "Step 1: Second start"
        }
      ],
      "expect": [
        {
          "mock": "messaging/messages/briefing-{today}-1",
          "field": "text",
          "contains": "Sources not available: stock exceptions"
        },
        {
          "mock": "messaging/messages/briefing-{today}-2",
          "field": "text",
          "contains": "Sources not available: stock exceptions"
        },
        {
          "mock": "messaging/messages/briefing-{today}-2",
          "field": "text",
          "contains": "no further start today"
        },
        {
          "calls": "GET /stock/exceptions",
          "count": 2
        }
      ]
    }
  ]
