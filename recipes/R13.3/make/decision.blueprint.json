      "id": 9,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Read the draft\": \"in1_Readthedraft\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read the draft\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n: $('Step 10: Nadia approves or discards').first().json.body.\nDATA[\"Step 10: Nadia approves or discards\"] = [{ json: { body: { \"draft_id\": input.t_draft_id, \"decision\": input.t_decision, \"by\": input.t_by } } }];\nconst BODIES = (out) => ({\"article_body\": out.article ? JSON.stringify(out.article) : null, \"register_body\": out.article ? JSON.stringify({ id: 'KB-@@article_id@@', title: out.article.title, owner: $('Config').first().json.article_owner, delegate: null, audience: $('Config').first().json.article_audience, review_date: out.review_date, expiry_date: out.expiry_date, status: 'current', version: '1.0', link: $('Config').first().json.kb_url + '/articles/@@article_id@@', kb_article: '@@article_id@@' }) : null, \"blocked_body\": out.outcome === 'refuse' ? JSON.stringify({ recipe: 'R13.3', item: $('Step 10: Nadia approves or discards').first().json.body.draft_id, reason: 'approval blocked', detail: out.reason, owner: $('Config').first().json.article_owner }) : null, \"done_body\": JSON.stringify({ status: 'done', result: out.outcome }), \"log_body\": JSON.stringify({ recipe: 'R13.3', item: $('Step 10: Nadia approves or discards').first().json.body.draft_id, decision: out.outcome === 'refuse' ? 'approval blocked' : out.outcome.replace('_', ' '), rules: { ticket: $('Read the draft').first().json.ticket_id, reason: out.reason || null }, approved_by: out.outcome === 'refuse' ? null : $('Step 10: Nadia approves or discards').first().json.body.by }), \"failed_body\": JSON.stringify({ recipe: 'R13.3', item: $('Step 10: Nadia approves or discards').first().json.body.draft_id, reason: 'write failed', detail: 'Publishing or registering failed part way; check the knowledge base and register, never retried', owner: $('Config').first().json.article_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 10: only the article owner approves or discards; every \"needs source\" claim must be worded by its source's owner first.\nconst cfg = $('Config').first().json;\nconst ev = $('Step 10: Nadia approves or discards').first().json.body;\nconst d = $('Read the draft').first().json;\nconst blocked = reason => [{ json: { outcome: 'refuse', reason } }];\nif (String(ev.by).toLowerCase() !== String(cfg.article_owner).toLowerCase()) return blocked(`decision by ${ev.by}, not the article owner`);\nif (d.status !== 'awaiting approval') return blocked(`draft is ${d.status}`);\nif (ev.decision === 'discard') return [{ json: { outcome: 'discard' } }];\nif (ev.decision !== 'approve') return blocked(`unknown decision ${ev.decision}`);\nconst unworded = (d.claims || []).filter(c => c.needs_source && (!c.worded_by || String(c.worded_by).toLowerCase() !== String(c.owner).toLowerCase()));\nif (unworded.length) return blocked(`needs source, not yet worded by ${[...new Set(unworded.map(c => c.owner))].join(', ')}`);\n// Step 11: the register needs review and expiry dates, or R13.2 withdraws the article.\nconst DAY = 86400000, today = new Date(new Date().toISOString().slice(0, 10) + 'T00:00:00Z');\nconst review = Number(cfg.article_review_days);\nconst review_date = Number.isFinite(review) ? new Date(today.getTime() + review * DAY).toISOString().slice(0, 10) : null;\nconst expiry_date = review_date ? new Date(today.getTime() + (review + cfg.expiry_after_review_days) * DAY).toISOString().slice(0, 10) : null;\nconst article = { title: d.title, question: d.question, answer: d.answer, steps: d.steps,\n                  policy_statements: (d.claims || []).filter(c => c.field === 'policy_claims' || c.needs_source).map(c => c.text),\n                  source_ticket: d.ticket_id, owner: cfg.article_owner };\nreturn [{ json: { outcome: d.kind === 'suggested update' && d.updates_article ? 'publish_update' : 'publish_new', article, review_date, expiry_date } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "t_draft_id",
            "value": "{{1.draft_id}}"
          },
