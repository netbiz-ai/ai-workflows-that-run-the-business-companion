        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R13.3\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"helpdesk_url\": \"https://<your helpdesk API>\",\n  \"drafts_url\": \"https://<your drafts area API, read only by the article owner's team>\",\n  \"kb_url\": \"https://<your knowledge base API>\",\n  \"register_url\": \"https://<your source register API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"reusable_tag\": \"reusable\",\n  \"access_code_field\": \"<your restricted access-code field>\",\n  \"personal_data_patterns\": [\n    {\n      \"name\": \"email\",\n      \"pattern\": \"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\"\n    },\n    {\n      \"name\": \"phone\",\n      \"pattern\": \"(?<![\\\\d])\\\\+?(?:\\\\d[\\\\s().-]?){8,13}\\\\d(?![\\\\d])\"\n    },\n    {\n      \"name\": \"order number\",\n      \"pattern\": \"<your order-number pattern>\"\n    }\n  ],\n  \"article_template\": \"<your article template>\",\n  \"price_list_link\": \"https://<your price list in the CRM>\",\n  \"policy_figures\": [\n    \"<your owner-approved policy figures, from R13.1's list>\"\n  ],\n  \"policy_topics\": [\n    {\n      \"keywords\": [\n        \"warranty\",\n        \"guarantee\"\n      ],\n      \"source\": \"<your returns and warranty source>\",\n      \"owner\": \"<its owner>\"\n    },\n    {\n      \"keywords\": [\n        \"return\",\n        \"refund\",\n        \"exchange\"\n      ],\n      \"source\": \"<your returns and warranty source>\",\n      \"owner\": \"<its owner>\"\n    },\n    {\n      \"keywords\": [\n        \"delivery\",\n        \"deliver\"\n      ],\n      \"source\": \"<your delivery source>\",\n      \"owner\": \"<its owner>\"\n    }\n  ],\n  \"title_match\": \"<your title-match threshold, 0 to 1>\",\n  \"article_owner\": \"<your knowledge-article owner>\",\n  \"article_audience\": [\n    \"<your customer service group>\"\n  ],\n  \"article_review_days\": \"<your review period for articles, in days>\",\n  \"expiry_after_review_days\": 30,\n  \"old_draft_days\": 14,\n  \"ai_model\": \"claude-haiku-5-5\",\n  \"ai_inference_geo\": \"us\",\n  \"ai_url\": \"https://api.anthropic.com/v1/messages\"\n};",
        "input": []
