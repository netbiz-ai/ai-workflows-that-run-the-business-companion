            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_Readthedraft",
            "value": "{{7.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
