{
  "config": {
    "register_url": "{mocks}/register",
    "tasks_url": "{mocks}/tasks",
    "tracking_url": "{mocks}/tracking",
    "calendar_url": "{mocks}/calendar",
    "agenda_url": "{mocks}/agenda",
    "workdays_url": "{mocks}/workdays",
    "messaging_url": "{mocks}/messaging",
    "working_weekdays": [0, 1, 2, 3, 4, 5, 6],
    "register_owner": "tom@example.test",
    "exception_owner": "owen@example.test"
  },
  "seed": {
    "register": {"series": {
      "S-DEL": {"id": "S-DEL", "name": "Delivery planning", "chair": "tom@example.test", "backup": "owen@example.test"}
    }},
    "tasks": {"tasks": {
      "TK-1": {"id": "TK-1", "title": "Send reschedule list to crews", "owner": "Nadia Ferreira", "owner_email": "nadia@example.test",
               "due_date": "{today-1}", "verified_due_date": "{today-1}", "series_id": "S-DEL", "status": "open",
               "source_link": "https://transcripts.example.test/TR-1?t=00%3A04%3A12"}
    }},
    "tracking": {"rows": {}},
    "calendar": {"meetings": {"M-1": {"id": "M-1", "series_id": "S-DEL", "start": "{today+7}"}}},
    "agenda": {"items": {}},
    "workdays": {"holidays": {}}
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "Task one day overdue, not reminded",
     "trigger": [{"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"mock": "messaging/messages", "count": 1},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["nadia@example.test"]},
       {"mock": "messaging/messages/1", "field": "text", "contains": "{today-1}"},
       {"mock": "tracking/rows/TK-1", "field": "reminder_state", "equals": "sent"},
       {"mock": "tracking/rows/TK-1", "field": "reminder_key", "equals": "TK-1:{today-1}"},
       {"mock": "agenda/items", "count": 0},
       {"sql": "select status from key_log where recipe='R14.3'", "equals": "done"}]},
    {"case": "Edge", "row": 2, "input": "Date moved twice, not overdue",
     "seed": {"tasks": {"tasks": {"TK-1": {"due_date": "{today+5}", "verified_due_date": "{today-2}"}}},
              "tracking": {"rows": {"TK-1": {"id": "TK-1", "series_id": "S-DEL", "verified_date": "{today-2}", "first_seen": "{today-9}",
                                             "last_due_seen": "{today+3}", "changes": 1, "reminder_key": "", "reminder_state": "none", "reminded_on": ""}}}},
     "trigger": [{"schedule": "Step 8: Each Friday"}],
     "expect": [
       {"mock": "agenda/items", "count": 1},
       {"mock": "agenda/items/1", "field": "meeting_id", "equals": "M-1"},
       {"mock": "agenda/items/1", "field": "verified_date", "equals": "{today-2}"},
       {"mock": "agenda/items/1", "field": "due_date", "equals": "{today+5}"},
       {"mock": "tracking/rows/TK-1", "field": "changes", "equals": 2},
       {"mock": "tracking/rows/TK-1", "field": "last_due_seen", "equals": "{today+5}"},
       {"calls": "POST /messaging/messages", "count": 1},
       {"sql": "select status from key_log where recipe='R14.3' and key='TK-1:M-1'", "equals": "done"}]},
    {"case": "Duplicate", "row": 3, "input": "Message sent, key not marked \"sent\"",
     "seed": {"tracking": {"rows": {"TK-1": {"id": "TK-1", "series_id": "S-DEL", "verified_date": "{today-1}", "first_seen": "{today}",
                                             "last_due_seen": "{today-1}", "changes": 0, "reminder_key": "TK-1:{today-1}", "reminder_state": "pending", "reminded_on": ""}}}},
     "trigger": [{"schedule": "Step 1: Early each working day", "pause": 2},
                 {"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"mock": "messaging/messages", "count": 0},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R14.3'", "equals": "reminder key pending / owen@example.test"},
       {"mock": "tracking/rows/TK-1", "field": "reminder_state", "equals": "pending"}]},
    {"case": "Escalate", "row": 4, "input": "No series meeting within 14 days",
     "seed": {"calendar": {"meetings": {"M-1": {"start": "{today+20}"}}},
              "tracking": {"rows": {"TK-1": {"id": "TK-1", "series_id": "S-DEL", "verified_date": "{today-1}", "first_seen": "{today-1}",
                                             "last_due_seen": "{today-1}", "changes": 0, "reminder_key": "TK-1:{today-1}", "reminder_state": "sent", "reminded_on": "{today-1}"}}}},
     "trigger": [{"schedule": "Step 1: Early each working day", "pause": 2},
                 {"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"mock": "messaging/messages", "count": 1},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["tom@example.test"]},
       {"mock": "agenda/items", "count": 0},
       {"sql": "select copies_skipped from key_log where recipe='R14.3' and key like '%:no meeting'", "equals": "1"}]},
    {"case": "Carried", "row": 5, "input": "Reminded a working day ago, still open, series meets in 7 days (companion extension)",
     "seed": {"tasks": {"tasks": {"TK-1": {"due_date": "{today-3}", "verified_due_date": "{today-3}"}}},
              "tracking": {"rows": {"TK-1": {"id": "TK-1", "series_id": "S-DEL", "verified_date": "{today-3}", "first_seen": "{today-2}",
                                             "last_due_seen": "{today-3}", "changes": 0, "reminder_key": "TK-1:{today-3}", "reminder_state": "sent", "reminded_on": "{today-1}"}}}},
     "trigger": [{"schedule": "Step 1: Early each working day", "pause": 2},
                 {"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"mock": "agenda/items", "count": 1},
       {"mock": "agenda/items/1", "field": "meeting_id", "equals": "M-1"},
       {"mock": "agenda/items/1", "field": "days_overdue", "equals": 3},
       {"mock": "agenda/items/1", "field": "owner", "equals": "Nadia Ferreira"},
       {"mock": "agenda/items/1", "field": "status", "equals": "listed"},
       {"mock": "messaging/messages", "count": 0}]},
    {"case": "Write fails", "row": 6, "input": "The reminder send fails (companion extension)",
     "fail": [{"method": "POST", "path": "/messaging/messages", "status": 500, "times": 1}],
     "trigger": [{"schedule": "Step 1: Early each working day", "pause": 2},
                 {"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"calls": "POST /messaging/messages", "count": 1},
       {"mock": "tracking/rows/TK-1", "field": "reminder_state", "equals": "pending"},
       {"sql": "select status from key_log where recipe='R14.3'", "equals": "failed"},
       {"sql": "select reason || ' / ' || owner from exception_queue where recipe='R14.3'", "equals": "write failed / owen@example.test"}]},
    {"case": "Holiday", "row": 7, "input": "The morning run on a holiday (companion extension)",
     "seed": {"workdays": {"holidays": {"H-1": {"id": "H-1", "date": "{today}"}}}},
     "trigger": [{"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"calls": "GET /tasks/tasks", "count": 0},
       {"mock": "messaging/messages", "count": 0}]},
    {"case": "New date", "row": 8, "input": "The chair sets a new date at the meeting (companion extension)",
     "seed": {"tracking": {"rows": {"TK-1": {"id": "TK-1", "series_id": "S-DEL", "verified_date": "{today-9}", "first_seen": "{today-9}",
                                             "last_due_seen": "{today-1}", "changes": 2, "reminder_key": "TK-1:{today-9}", "reminder_state": "sent", "reminded_on": "{today-8}"}}},
              "agenda": {"items": {"AG-1": {"id": "AG-1", "meeting_id": "M-0", "task_id": "TK-1", "status": "listed", "decision": "new date", "new_date": "{today+10}"}}}},
     "trigger": [{"webhook": "r14-3-meeting-decided", "body": {"meeting_id": "M-0"}}],
     "expect": [
       {"mock": "tracking/rows/TK-1", "field": "verified_date", "equals": "{today+10}"},
       {"mock": "tracking/rows/TK-1", "field": "changes", "equals": 0},
       {"calls": "PATCH /tasks/tasks/TK-1", "count": 0},
       {"sql": "select count(*) from decision_log where recipe='R14.3' and decision='new date verified'", "equals": "1"}]},
    {"case": "Closed since listed", "row": 9, "input": "A listed task closed before its meeting (companion extension)",
     "seed": {"tasks": {"tasks": {"TK-1": {"status": "closed"}}},
              "agenda": {"items": {"AG-1": {"id": "AG-1", "meeting_id": "M-1", "task_id": "TK-1", "status": "listed"}}}},
     "trigger": [{"schedule": "Step 1: Early each working day"}],
     "expect": [
       {"mock": "agenda/items/AG-1", "field": "status", "equals": "closed since listed"},
       {"mock": "agenda/items", "count": 1},
       {"mock": "messaging/messages", "count": 0}]}
  ]
}
