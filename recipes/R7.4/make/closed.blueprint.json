        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 7: Read the closed item\": \"in1_Step7Readthecloseditem\", \"Step 7: Read the invoice record\": \"in2_Step7Readtheinvoicerecor\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 7: Read the invoice record\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as the rule reads them in n8n.\nDATA[\"Step 7: Item closed\"] = [{ json: { body: { item_id: input.t_item_id, resolution: input.t_resolution, resolved_by: input.t_resolved_by, note: input.t_note } } }];\nconst BODIES = (out) => ({\"rematch_body\": JSON.stringify({ record_id: $('Step 7: Read the closed item').first().json.invoice_id, resolved_by: $('Step 7: Item closed').first().json.body.resolved_by }), \"approval_body\": JSON.stringify({ invoice_id: $('Step 7: Read the closed item').first().json.invoice_id, approver: out.approver, total: $('Step 7: Read the invoice record').first().json.total, note: $('Step 7: Item closed').first().json.body.note || '', resolved_by: $('Step 7: Item closed').first().json.body.resolved_by, status: 'waiting' }), \"reject_body\": JSON.stringify({ status: 'rejected', rejected_by: $('Step 7: Item closed').first().json.body.resolved_by, note: $('Step 7: Item closed').first().json.body.note || '' }), \"close_body\": JSON.stringify({ status: 'closed', resolution: $('Step 7: Item closed').first().json.body.resolution, resolved_by: $('Step 7: Item closed').first().json.body.resolved_by, closed_on: new Date().toISOString().slice(0, 10) }), \"log_body\": JSON.stringify({ recipe: 'R7.4', item: $('Step 7: Item closed').first().json.body.item_id, decision: 'closed: ' + out.route + (out.approver ? ' to ' + out.approver : ''), rules: out.rules }), \"failed_body\": JSON.stringify({ recipe: 'R7.4', item: $('Step 7: Item closed').first().json.body.item_id, reason: 'write failed', detail: 'Rematch, approval, rejection or close write failed, never retried; finish it by hand', owner: $('Config').first().json.workflow_owner })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 7: a corrected record or released hold rematches; anything else goes to the payment approver, or is rejected.\nconst cfg = $('Config').first().json;\nconst b = $('Step 7: Item closed').first().json.body;\nconst rec = $('Step 7: Read the invoice record').first().json;\nif (['corrected record', 'released hold'].includes(b.resolution)) return [{ json: { route: 'rematch', rules: { resolution: b.resolution } } }];\nif (b.resolution === 'rejected') return [{ json: { route: 'reject', rules: { resolution: b.resolution } } }];\nlet approver = Number(rec.total) <= Number(cfg.approval_limit) ? cfg.approver_to_limit : cfg.approver_above;\nlet rule = Number(rec.total) <= Number(cfg.approval_limit) ? 'up to the limit' : 'above the limit';\nif (approver === b.resolved_by) { approver = cfg.approver_own_items; rule += '; approver resolved the item'; }\nreturn [{ json: { route: 'approve', approver, rules: { resolution: b.resolution, approver: rule } } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
