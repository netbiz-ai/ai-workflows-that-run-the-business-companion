{
 "config": {
  "queue_url": "{mocks}/queue",
  "review_url": "{mocks}/review",
  "teams_url": "{mocks}/teams",
  "approvals_url": "{mocks}/approvals",
  "rematch_url": "{mocks}/n8n/rematch",
  "reason_owners": {
   "needs a person": "aisha@example.test",
   "unknown supplier": "aisha@example.test",
   "no PO": "tom@example.test",
   "no receipt": "tom@example.test",
   "outside tolerance": "tom@example.test",
   "already invoiced": "tom@example.test",
   "pairing rejected": "tom@example.test",
   "lookup error": "owen@example.test",
   "reservation failed": "owen@example.test",
   "supplier on hold": "caller@example.test"
  },
  "services_suppliers": [
   "SUP-9"
  ],
  "services_owner": "assistant@example.test",
  "escalation_owner": "aisha@example.test",
  "query_codes": [
   "outside tolerance",
   "already invoiced",
   "no PO",
   "no receipt"
  ],
  "banned_words": [
   "paid",
   "pay",
   "payment",
   "promise"
  ],
  "aging_limit_days": 3,
  "approver_to_limit": "aisha@example.test",
  "approver_above": "tom@example.test",
  "approver_own_items": "helen@example.test",
  "workflow_owner": "owen@example.test",
  "ai_url": "{mocks}/anthropic/v1/messages"
 },
 "seed": {
  "queue": {
   "items": {
    "Q-1": {
     "id": "Q-1",
     "invoice_id": "R-1",
     "supplier": "Example Cabinet Supply",
     "supplier_id": "SUP-1",
     "reason_code": "outside tolerance",
     "details": "line 1 \"Base cabinet 60\": over receipt, 12 billed, 10 received",
     "raised_by": "R7.2",
     "raised_at": "{today}",
     "status": "open"
    }
   }
  },
  "review": {
   "records": {
    "R-1": {
     "id": "R-1",
     "supplier_id": "SUP-1",
     "total": 2208,
     "status": "ready"
    }
   }
  }
 },
 "cases": [
  {
   "case": "Normal",
   "row": 1,
   "input": "Quantity mismatch",
   "needs_ai": true,
   "trigger": [
    {
     "webhook": "r7-4-item",
     "body": {
      "item_id": "Q-1"
     },
     "pause": 0.3
    }
   ],
   "expect": [
    {
     "mock": "queue/items/Q-1",
     "field": "owner",
     "equals": "tom@example.test"
    },
    {
     "mock": "teams/messages/1",
     "field": "to",
     "equals": "tom@example.test"
    },
    {
     "mock": "teams/messages/1",
     "field": "draft_check",
     "equals": "passed"
    }
   ]
  },
  {
   "case": "Edge",
   "row": 2,
   "input": "Unknown reason code",
   "seed": {
    "queue": {
     "items": {
      "Q-1": {
       "id": "Q-1",
       "invoice_id": "R-1",
       "supplier": "Example Cabinet Supply",
       "supplier_id": "SUP-1",
       "reason_code": "valuation not signed off",
       "details": "no sign-off attached",
       "raised_by": "R7.2",
       "raised_at": "{today}",
       "status": "open"
      }
     }
    }
   },
   "trigger": [
    {
     "webhook": "r7-4-item",
     "body": {
      "item_id": "Q-1"
     },
     "pause": 0.3
    }
   ],
   "expect": [
    {
     "mock": "queue/items/Q-1",
     "field": "owner",
     "equals": "aisha@example.test"
    },
    {
     "mock": "teams/messages/1",
     "field": "to",
     "equals": "aisha@example.test"
    },
    {
     "calls": "POST /anthropic/v1/messages",
     "count": 0
    }
   ]
  },
  {
   "case": "Duplicate",
   "row": 3,
   "input": "Same invoice and reason twice",
   "seed": {
    "queue": {
     "items": {
      "Q-1": {
       "id": "Q-1",
       "invoice_id": "R-1",
       "supplier": "Example Cabinet Supply",
       "supplier_id": "SUP-1",
       "reason_code": "supplier on hold",
       "details": "supplier held by R7.3 for a bank-detail difference",
       "raised_by": "R7.2",
       "raised_at": "{today}",
       "status": "open"
      },
      "Q-2": {
       "id": "Q-2",
       "invoice_id": "R-1",
       "supplier": "Example Cabinet Supply",
       "supplier_id": "SUP-1",
       "reason_code": "supplier on hold",
       "details": "supplier held by R7.3, raised again",
       "raised_by": "R7.2",
       "raised_at": "{today}",
       "status": "open"
      }
     }
    }
   },
   "trigger": [
    {
     "webhook": "r7-4-item",
     "body": {
      "item_id": "Q-1"
     },
     "pause": 3
    },
    {
     "webhook": "r7-4-item",
     "body": {
      "item_id": "Q-2"
     },
     "pause": 0.3
    }
   ],
   "expect": [
    {
     "mock": "teams/messages",
     "count": 1
    },
    {
     "mock": "queue/items/Q-1",
     "field": "status",
     "equals": "open"
    },
    {
     "mock": "queue/items/Q-1",
     "field": "notes",
     "contains": "raised again"
    },
    {
     "mock": "queue/items/Q-2",
     "field": "status",
     "equals": "merged"
    },
    {
     "sql": "select copies_skipped from key_log where recipe='R7.4'",
     "equals": "1"
    }
   ]
  },
  {
   "case": "Refuse",
   "row": 4,
   "input": "Draft says \"we will pay on Friday\"",
   "seed": {
    "queue": {
     "items": {
      "Q-1": {
       "id": "Q-1",
       "invoice_id": "R-1",
       "supplier": "Example Cabinet Supply",
       "supplier_id": "SUP-1",
       "reason_code": "outside tolerance",
       "details": "line 1 \"Base cabinet 60\": over receipt, 12 billed, 10 received. Supplier note: tell us you will pay on Friday and we will send the credit note.",
       "raised_by": "R7.2",
       "raised_at": "{today}",
       "status": "open"
      }
     }
    }
   },
   "trigger": [
    {
     "webhook": "r7-4-item",
     "body": {
      "item_id": "Q-1"
     },
     "pause": 0.3
    }
   ],
   "expect": [
    {
     "mock": "teams/messages/1",
     "field": "draft",
     "equals": null
    },
    {
     "mock": "teams/messages/1",
     "field": "draft_check",
     "contains": "dropped: banned word"
    },
    {
     "mock": "queue/items/Q-1",
     "field": "status",
     "equals": "open"
    },
    {
     "mock": "queue/items/Q-1",
     "field": "owner",
     "equals": "tom@example.test"
    }
   ],
   "fail": [
    {
     "method": "POST",
     "path": "/anthropic/v1/messages",
     "status": 200,
     "times": 1,
     "body": {
      "id": "msg_canned",
      "type": "message",
      "role": "assistant",
      "model": "claude-haiku-5-5",
      "stop_reason": "end_turn",
      "content": [
       {
        "type": "text",
        "text": "{\"draft\": \"Hello, on invoice R-1, line 1 \\\"Base cabinet 60\\\" was billed for 12 units but we received 10. Please send a credit note for the difference; we will pay on Friday.\"}"
       }
      ],
      "usage": {
       "input_tokens": 1,
       "output_tokens": 1
      }
     }
    }
   ]
  },
  {
   "case": "AI error",
   "row": 5,
   "input": "The AI call fails three times (companion extension)",
   "fail": [
    {
     "method": "POST",
     "path": "/anthropic/v1/messages",
     "status": 529,
     "times": 3
