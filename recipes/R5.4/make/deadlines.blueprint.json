      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Read quotes awaiting approval\": \"in1_Readquotesawaitingapprov\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read quotes awaiting approval\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"quote_q\": encodeURIComponent(out.quote_id), \"remind_message\": JSON.stringify({ to: out.approver, subject: 'Reminder: approve quote ' + out.quote_id, text: 'The response deadline has passed. ' + $('Config').first().json.checklist }), \"deputy_message\": JSON.stringify({ to: out.deputy, subject: 'Please approve quote ' + out.quote_id + ' as deputy', text: 'The approver has not decided by twice the deadline. ' + $('Config').first().json.checklist }), \"escalation_body\": JSON.stringify({ escalation: out.stage }), \"ben_message\": JSON.stringify({ to: $('Config').first().json.approvers.sales_lead.person, subject: 'Quote ' + out.quote_id + ' returned: no decision', text: 'No decision by three times the deadline; the quote is returned, locked.' }), \"failed_body\": JSON.stringify({ recipe: 'R5.4', item: String(out.quote_id), reason: 'deadline action failed', detail: 'A reminder, deputy request or return failed, not retried; act on the quote by hand', owner: $('Config').first().json.approvers.sales_lead.person })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 7: remind at the deadline, ask the deputy at twice it, return at three times it.\nconst quotes = $('Read quotes awaiting approval').first().json.items || [];\nconst now = Date.now();\nconst out = [];\nfor (const q of quotes) {\n  if (!q.requested_at || !q.deadline_hours || !q.approver) continue;\n  const stage = Math.min(3, Math.floor((now - new Date(q.requested_at).getTime()) / 3600000 / Number(q.deadline_hours)));\n  if (stage <= Number(q.escalation || 0)) continue;\n  const action = ['', 'remind', 'deputy', 'return'][stage];\n  out.push({ json: { quote_id: q.id, revision: q.revision, action, stage, approver: q.approver, deputy: q.deputy, salesperson: q.salesperson } });\n}\nreturn out;\n};\nreturn { items: one(__rule()).map(o => Object.assign({}, o, BODIES(o))) };\n",
        "input": [
