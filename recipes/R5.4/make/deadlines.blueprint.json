        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\n// Schedule: set this scenario to run every hour; Make keeps the schedule outside the blueprint.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R5.4\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"crm_url\": \"https://<your CRM API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"salesperson_limit\": \"<your salesperson's limit, after discount>\",\n  \"sales_lead_limit\": \"<your sales lead's limit, after discount>\",\n  \"standard_discount_pct\": \"<your standard line discount, %>\",\n  \"approvers\": {\n    \"salesperson\": {\n      \"deputy\": \"<your salespeople's deputy>\",\n      \"deadline_hours\": \"<hours>\"\n    },\n    \"sales_lead\": {\n      \"person\": \"<your sales lead>\",\n      \"deputy\": \"<deputy>\",\n      \"deadline_hours\": \"<hours>\"\n    },\n    \"ceo\": {\n      \"person\": \"<your owner or CEO>\",\n      \"deputy\": \"<deputy>\",\n      \"deadline_hours\": \"<hours>\"\n    }\n  },\n  \"checklist\": \"<link to your copy of Book 1's Checklist 13.1, the quote approver's check>\",\n  \"systems_owner\": \"<your systems owner>\"\n};",
        "input": []
      },
