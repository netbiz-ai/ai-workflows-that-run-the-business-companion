        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Read the quote (decision)\": \"in1_Readthequotedecision\", \"Read the price list (decision)\": \"in2_Readthepricelistdecision\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Read the price list (decision)\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as n8n's Webhook node gives them.\nDATA['Step 8: Decision recorded'] = [{ json: { body: Object.fromEntries(Object.entries({ quote_id: input.tr_quote_id, revision: input.tr_revision, decision: input.tr_decision, by: input.tr_by, comment: input.tr_comment }).filter(([, v]) => v !== undefined && v !== null && v !== '')) } }];\nconst BODIES = (out) => ({\"unlock_body\": JSON.stringify({ status: 'approved', locked: false, approved_by: $('Step 8: Decision recorded').first().json.body.by, approved_at: new Date().toISOString(), approved_revision: $('Read the quote (decision)').first().json.revision }), \"return_body\": JSON.stringify({ status: 'returned', locked: true, rejected_by: $('Step 8: Decision recorded').first().json.body.by, comment: $('Step 8: Decision recorded').first().json.body.comment || '' }), \"back_body\": JSON.stringify({ status: 'back to R5.3', locked: true, return_reason: out.reason }), \"salesperson_message\": JSON.stringify({ to: $('Read the quote (decision)').first().json.salesperson, subject: 'Quote ' + $('Step 8: Decision recorded').first().json.body.quote_id + ' back to drafting', text: 'The price list changed while it waited for approval; mark the opportunity ready to quote again to redraft it.' }), \"refused_body\": JSON.stringify({ recipe: 'R5.4', item: String($('Step 8: Decision recorded').first().json.body.quote_id), reason: 'decision not accepted', detail: out.reason, owner: $('Config').first().json.approvers.sales_lead.person }), \"failed_body\": JSON.stringify({ recipe: 'R5.4', item: String($('Step 8: Decision recorded').first().json.body.quote_id), reason: 'write failed', detail: 'Decision write failed, not retried; set the quote by hand, then release the key', owner: $('Config').first().json.approvers.sales_lead.person })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\nfunction recompute(q, list) {\n  const onList = new Set((list.items || []).map(i => i.code));\n  let cents = 0, largest = 0, offList = false, multiYear = Number(q.term_years || 0) > 1;\n  for (const l of q.lines || []) {\n    const disc = Number(l.discount_pct || 0);\n    largest = Math.max(largest, disc);\n    if (Number(l.years || 0) > 1) multiYear = true;\n    if (l.off_list || l.unit_price == null || !onList.has(l.code)) { offList = true; continue; }\n    const u = BigInt(Math.round(Number(l.unit_price) * 10000)), d = BigInt(Math.round(disc * 100));\n    cents += Number((u * BigInt(Number(l.quantity)) * (10000n - d) + 500000n) / 1000000n);\n  }\n  return { value: cents / 100, largest_discount: largest, multi_year: multiYear, off_list: offList, non_standard: q.non_standard_terms === true };\n}\nfunction listCurrent(q, list) {\n  const today = new Date().toISOString().slice(0, 10);\n  return q.price_list_version === list.version && !!list.valid_until && list.valid_until >= today;\n}\n\n// Step 8: only the routed approver or deputy, on the revision they were asked about, decides.\nconst q = $('Read the quote (decision)').first().json, list = $('Read the price list (decision)').first().json;\nconst d = $('Step 8: Decision recorded').first().json.body;\nconst problems = [];\nif (q.status !== 'awaiting approval') problems.push(`quote is ${q.status}, not awaiting approval`);\nif (Number(d.revision) !== Number(q.revision)) problems.push(`decision on revision ${d.revision}; the quote is now revision ${q.revision} and routes again`);\nif (![q.approver, q.deputy].includes(d.by)) problems.push(`${d.by} is not the routed approver or deputy`);\nif (!['approved', 'rejected'].includes(d.decision)) problems.push(`decision \"${d.decision}\" is not approved or rejected`);\nif (problems.length) return [{ json: { outcome: 'refuse', reason: problems.join('; ') } }];\nif (d.decision === 'approved' && !listCurrent(q, list)) return [{ json: { outcome: 'back', reason: `price list ${q.price_list_version} replaced by ${list.version} while waiting` } }];\nreturn [{ json: Object.assign({ outcome: d.decision === 'approved' ? 'approve' : 'reject' }, recompute(q, list)) }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
