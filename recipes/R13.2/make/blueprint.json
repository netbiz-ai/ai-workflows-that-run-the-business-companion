{
  "name": "R13.2 Flag stale documents: major version published",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Step 9: Major version published"
        }
      }
    },
    {
      "id": 2,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R13.2\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"register_url\": \"https://<your source register API>\",\n  \"directory_url\": \"https://<your directory API>\",\n  \"documents_url\": \"https://<your document home API>\",\n  \"index_url\": \"https://<your answer index API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"due_within_days\": 14,\n  \"expiry_after_review_days\": 30,\n  \"inactive_statuses\": [\n    \"withdrawn\",\n    \"retired\"\n  ],\n  \"archive_folder\": \"<your archive no bought assistant can open>\",\n  \"owner_form_url\": \"https://<your owner form>\",\n  \"register_admin\": \"<your register admin, who edits owners and dates>\"\n};",
        "input": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Config"
        }
      }
    },
    {
      "id": 5,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.stop_flag_url}}",
        "method": "get",
        "timeout": "40",
        "parseResponse": true,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Stop flag: read"
        }
      },
      "onerror": [
        {
          "id": 3,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {},
          "mapper": {
            "url": "{{2.result.table_api_url}}/exception_queue",
            "method": "post",
            "timeout": "40",
            "parseResponse": false,
            "stopOnHttpError": true,
            "allowRedirects": true,
            "shareCookies": false,
            "requestCompressedContent": true,
            "contentType": "json",
            "inputMethod": "jsonString",
            "jsonStringBodyContent": "{\"recipe\": \"R13.2\", \"item\": \"run {{var.scenario.executionId}}\", \"reason\": \"stop list unreadable\", \"detail\": \"The stop list could not be read, so the run stopped\", \"owner\": \"{{2.result.workflow_owner}}\"}"
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Stop flag: list unreadable"
            }
          }
        },
        {
          "id": 4,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 900,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.table_api_url}}/rpc/reserve_key",
        "method": "post",
        "timeout": "40",
        "parseResponse": true,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"p_recipe\": \"R13.2\", \"p_key\": \"{{1.source_id}}:{{1.version}}:rebuild\"}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Step 9: Reserve key"
        }
      },
      "filter": {
        "name": "stop flag not set, major version",
        "conditions": [
          [
            {
              "a": "{{5.data.stopped}}",
              "b": "true",
              "o": "text:notequal"
            },
            {
              "a": "{{1.major}}",
              "b": "true",
              "o": "text:equal"
            }
          ]
        ]
      }
    },
    {
      "id": 10,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.index_url}}/rebuilds",
        "method": "post",
        "timeout": "40",
        "parseResponse": false,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"source_id\": \"{{1.source_id}}\", \"version\": \"{{1.version}}\", \"remove_older_versions\": true}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Step 9: Index: rebuild the source's passages"
        }
      },
      "onerror": [
        {
          "id": 7,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {},
          "mapper": {
            "url": "{{2.result.table_api_url}}/key_log?recipe=eq.R13.2&key=eq.{{encodeURL(1.source_id)}}%3A{{encodeURL(1.version)}}%3Arebuild",
            "method": "patch",
            "timeout": "40",
            "parseResponse": false,
            "stopOnHttpError": true,
            "allowRedirects": true,
            "shareCookies": false,
            "requestCompressedContent": true,
            "contentType": "json",
            "inputMethod": "jsonString",
            "jsonStringBodyContent": "{\"status\": \"failed\", \"result\": \"rebuild request failed\"}"
          },
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 300,
              "name": "Step 9: Mark key failed"
            }
          }
        },
        {
          "id": 8,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {},
          "mapper": {
            "url": "{{2.result.table_api_url}}/exception_queue",
            "method": "post",
            "timeout": "40",
            "parseResponse": false,
            "stopOnHttpError": true,
            "allowRedirects": true,
            "shareCookies": false,
            "requestCompressedContent": true,
            "contentType": "json",
            "inputMethod": "jsonString",
            "jsonStringBodyContent": "{\"recipe\": \"R13.2\", \"item\": \"{{1.source_id}}\", \"reason\": \"write failed\", \"detail\": \"Index rebuild request failed; rerun it (step 10 also flags the version)\", \"owner\": \"{{2.result.register_admin}}\"}"
          },
          "metadata": {
            "designer": {
              "x": 1500,
              "y": 300,
              "name": "Step 9: Exception queue: rebuild failed"
            }
          }
        },
        {
          "id": 9,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 1800,
              "y": 300
            }
          }
        }
      ],
      "filter": {
        "name": "new key (not a copy)",
        "conditions": [
          [
            {
              "a": "{{6.data}}",
              "b": "true",
              "o": "text:equal"
            }
          ]
        ]
      }
    },
    {
      "id": 11,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.table_api_url}}/key_log?recipe=eq.R13.2&key=eq.{{encodeURL(1.source_id)}}%3A{{encodeURL(1.version)}}%3Arebuild",
        "method": "patch",
        "timeout": "40",
        "parseResponse": false,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"status\": \"done\", \"result\": \"rebuild requested\"}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "Step 9: Mark key done"
        }
      }
    },
    {
      "id": 12,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "{{2.result.table_api_url}}/decision_log",
        "method": "post",
        "timeout": "40",
        "parseResponse": false,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\"recipe\": \"R13.2\", \"item\": \"{{1.source_id}}\", \"decision\": \"rebuild passages\", \"rules\": {\"version\": \"{{1.version}}\", \"major\": true}}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0,
          "name": "Step 9: Decision log"
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "dlq": true,
      "slots": null,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}
