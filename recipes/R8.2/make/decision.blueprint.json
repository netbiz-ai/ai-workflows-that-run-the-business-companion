                "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 8: Read the batch\": \"in1_Step8Readthebatch\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 8: Read the batch\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as n8n's Webhook node gives them.\nDATA['Step 8: Aisha decides on the batch'] = [{ json: { body: Object.fromEntries(Object.entries({ approved: input.tr_approved, by: input.tr_by }).filter(([, v]) => v !== undefined && v !== null && v !== '')) } }];\nconst BODIES = (out) => ({\"key_q\": encodeURIComponent(out.key), \"reserve_body\": JSON.stringify({ p_recipe: 'R8.2', p_key: out.key }), \"mail_body\": JSON.stringify({ from: $('Config').first().json.ar_mailbox, to: out.to, subject: out.subject, text: out.text }), \"sent_log\": JSON.stringify({ recipe: 'R8.2', item: out.account, decision: 'sent statement ' + out.month, rules: { month: out.month, balance: out.balance, total_due: out.total_due, held: false, by: ($('Step 8: Aisha decides on the batch').first().json.body.by || null) } }), \"unsent_exception\": JSON.stringify({ recipe: 'R8.2', item: out.account, reason: 'send failed', detail: 'Statement for ' + out.month + ' not sent; Owen restarts the run', owner: $('Config').first().json.ar_lead }), \"unsent_log\": JSON.stringify({ recipe: 'R8.2', item: out.account, decision: 'unsent statement ' + out.month, rules: { month: out.month, balance: out.balance } })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 8: one item per approved statement, each with its key (account plus statement month).\nconst b = $('Step 8: Read the batch').first().json;\nreturn (b.statements || []).map(s => ({ json: Object.assign({}, s, { month: b.month, key: s.account + ':' + b.month }), pairedItem: 0 }));\n};\nreturn { items: one(__rule()).map(o => Object.assign({}, o, BODIES(o))) };\n",
                "input": [
