    {
      "id": 6,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Config\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as n8n's Webhook node gives them.\nDATA['Step 8: Aisha decides on the batch'] = [{ json: { body: Object.fromEntries(Object.entries({ approved: input.tr_approved, by: input.tr_by }).filter(([, v]) => v !== undefined && v !== null && v !== '')) } }];\nconst BODIES = (out) => ({\"rejected_log\": JSON.stringify({ recipe: 'R8.2', item: 'statements ' + out.month, decision: 'batch rejected; nothing sent', rules: { by: ($('Step 8: Aisha decides on the batch').first().json.body.by || null) } })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// The statement month's cut-off: the last month-end, unless Config names one.\nconst cutoffFor = (cfg) => {\n  if (cfg.cutoff) return String(cfg.cutoff).slice(0, 10);\n  const n = new Date();\n  return new Date(Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), 0)).toISOString().slice(0, 10);\n};\n\n// Step 8: Aisha's decision is on this month's batch.\nconst month = cutoffFor($('Config').first().json).slice(0, 7);\nreturn [{ json: { id: 'statements-' + month, month } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
