        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R8.2\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"sharepoint_url\": \"https://<your SharePoint lists API>\",\n  \"crm_url\": \"https://<your CRM API>\",\n  \"mail_url\": \"https://<your AR mailbox API>\",\n  \"approvals_url\": \"https://<your approvals API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"ar_mailbox\": \"<your shared AR mailbox>\",\n  \"ar_lead\": \"<your AR lead, who approves the batch>\",\n  \"cutoff\": \"\",\n  \"statement_subject\": \"<your statement subject; merge fields \\u007b{month}} and \\u007b{account_name}}>\",\n  \"how_to_pay\": \"<how your customers pay>\",\n  \"where_to_ask\": \"<where a customer asks about a statement>\"\n};",
