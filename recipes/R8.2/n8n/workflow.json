      "id": "b5ebbcb8-aacb-5b2c-a90b-93b7a5e07ad2",
      "name": "Step 5: Read statements already sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3380,
        200
      ],
      "credentials": {
        "postgres": {
