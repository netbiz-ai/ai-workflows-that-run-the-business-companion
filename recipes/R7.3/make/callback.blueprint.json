        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 7: Read the register entry\": \"in1_Step7Readtheregisterentr\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 7: Read the register entry\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as n8n's Webhook node gives them.\nDATA['Step 7: Call-back logged'] = [{ json: { body: Object.fromEntries(Object.entries({ supplier_id: input.tr_supplier_id, task_id: input.tr_task_id, number_dialed: input.tr_number_dialed, outcome: input.tr_outcome, new_bank_account: input.tr_new_bank_account, new_phone: input.tr_new_phone, logged_by: input.tr_logged_by }).filter(([, v]) => v !== undefined && v !== null && v !== '')) } }];\nconst BODIES = (out) => ({\"entry_body\": JSON.stringify(out.entry), \"register_q\": encodeURIComponent(out.register_id), \"enter_task\": JSON.stringify({ assignee: $('Config').first().json.finance_assistant, supplier_id: $('Step 7: Call-back logged').first().json.body.supplier_id, status: 'open', instruction: 'The caller confirmed a bank-detail change on the number on file. Enter it in the ledger; the hold lifts when the next export shows it.' }), \"release_task\": JSON.stringify({ assignee: $('Config').first().json.finance_assistant, supplier_id: $('Step 7: Call-back logged').first().json.body.supplier_id, status: 'open', instruction: 'The caller confirmed no change on the number on file. Release the hold.' }), \"release_keys_body\": JSON.stringify({ p_recipe: 'R7.3', p_item: $('Step 7: Call-back logged').first().json.body.supplier_id }), \"fraud_message\": JSON.stringify({ to: $('Config').first().json.fraud_report_to, subject: 'Suspected payment fraud: supplier ' + $('Step 7: Call-back logged').first().json.body.supplier_id, text: 'A bank-detail change was not confirmed on the number on file. The hold stays.' }), \"fraud_exception\": JSON.stringify({ recipe: 'R7.3', item: $('Step 7: Call-back logged').first().json.body.supplier_id, reason: 'suspected fraud', detail: 'Change not confirmed on the number on file; hold stays', owner: $('Config').first().json.fraud_report_to }), \"wrong_number_exception\": JSON.stringify({ recipe: 'R7.3', item: $('Step 7: Call-back logged').first().json.body.supplier_id, reason: 'call to another number', detail: 'Logged number differs from the register; hold stays; ring the register number', owner: $('Config').first().json.bank_caller }), \"failed_body\": JSON.stringify({ recipe: 'R7.3', item: $('Step 7: Call-back logged').first().json.body.supplier_id, reason: 'write failed', detail: 'A register, hold, task or report write failed after a call-back, never retried; finish it by hand', owner: $('Config').first().json.workflow_owner }), \"log_body\": JSON.stringify({ recipe: 'R7.3', item: $('Step 7: Call-back logged').first().json.body.supplier_id, decision: 'call-back: ' + out.route, rules: out.rules })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 7: the caller logged the number dialed and the outcome; only the register's number counts.\nconst b = $('Step 7: Call-back logged').first().json.body;\nconst reg = ($('Step 7: Read the register entry').first().json.items || [])[0] || null;\nconst digits = s => String(s || '').replace(/\\D/g, '');\nconst onFile = reg && reg.phone ? digits(reg.phone) : null;\nconst rules = { outcome: b.outcome, number_on_file: !!onFile };\nlet route;\nif (onFile && digits(b.number_dialed) !== onFile) route = 'wrong number';\nelse if (b.outcome !== 'confirmed') route = 'not confirmed';\nelse if (b.new_bank_account || b.new_phone) route = 'change';\nelse route = 'no change';\nrules.route = route;\nconst entry = Object.assign({}, reg || { id: b.supplier_id, supplier_id: b.supplier_id });\nif (b.new_bank_account) entry.bank_account = b.new_bank_account;\nif (b.new_phone) entry.phone = b.new_phone;\nentry.verified_on = new Date().toISOString().slice(0, 10);\nentry.verified_by = b.logged_by || null;\nreturn [{ json: { route, rules, entry, register_id: entry.id } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
