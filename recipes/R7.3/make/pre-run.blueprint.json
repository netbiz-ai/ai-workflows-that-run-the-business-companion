    {
      "id": 2,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R7.3\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"review_url\": \"https://<your review list API>\",\n  \"mailbox_url\": \"https://<your AP mailbox API>\",\n  \"exports_url\": \"https://<your supplier export library API>\",\n  \"suppliers_url\": \"https://<your supplier list API>\",\n  \"register_url\": \"https://<your bank register API>\",\n  \"checks_url\": \"https://<your R7.3 check list API>\",\n  \"tasks_url\": \"https://<your task list API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"change_phrases\": [\n    \"new bank\",\n    \"<your change-request phrases>\"\n  ],\n  \"bank_caller\": \"<your caller, not a payment approver>\",\n  \"finance_assistant\": \"<your bank-change enterer, not a payment approver>\",\n  \"fraud_report_to\": \"<who you report suspected fraud to>\",\n  \"pre_run_reviewer\": \"<your AP owner>\",\n  \"kill_switch_alert\": \"<who is alerted when R7.3 is off>\"\n};",
        "input": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Config"
        }
      }
    },
    {
      "id": 5,
