    {
      "id": 10,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Pre-run: Read the export checks\": \"in1_PrerunReadtheexportcheck\", \"Pre-run: Read the suppliers\": \"in2_PrerunReadthesuppliers\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Pre-run: Read the suppliers\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"confirm_message\": JSON.stringify({ to: [$('Config').first().json.bank_caller, $('Config').first().json.pre_run_reviewer], subject: 'Payment run check', text: 'Export check logged. Held suppliers: ' + (out.held.join(', ') || 'none') + '. Confirm no bill is from a held supplier and every bill has a logged approval. Whoever releases the run must not have approved its bills.' }), \"alert_message\": JSON.stringify({ to: $('Config').first().json.kill_switch_alert, subject: 'No R7.3 export check before the payment run', text: 'No export check is logged today, so every supplier is held until the check runs.' }), \"every\": out.all.map(id => ({ id, supplier_q: encodeURIComponent(id), failed_body: JSON.stringify({ recipe: 'R7.3', item: id || 'supplier', reason: 'write failed', detail: 'Pre-run hold write failed; hold this supplier by hand', owner: $('Config').first().json.workflow_owner }) }))});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Before each payment run: today's export check must be logged; held suppliers are listed for the caller and the AP owner.\nconst today = new Date().toISOString().slice(0, 10);\nconst checks = ($('Pre-run: Read the export checks').first().json.items || []).filter(c => c.source === 'export' && c.checked_on === today);\nconst sups = $('Pre-run: Read the suppliers').first().json.items || [];\nreturn [{ json: { logged: checks.length > 0, held: sups.filter(s => s.hold).map(s => s.name || s.id), all: sups.map(s => s.id) } }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_PrerunReadtheexportcheck",
            "value": "{{7.data}}"
          },
          {
            "name": "in2_PrerunReadthesuppliers",
            "value": "{{9.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "Pre-run: Rule: export check logged?"
        }
      }
    },
