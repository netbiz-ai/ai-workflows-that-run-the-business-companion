                        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Step 2: Rule: differs from the register?\": \"in0_Step2Rulediffersfromther\", \"Config\": \"in1_Config\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 2: Rule: differs from the register?\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"task_body\": JSON.stringify(out)});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\n// Step 6: the caller's task carries the register's number, never one from the message or invoice.\nconst c = $('Step 2: Rule: differs from the register?').item.json;\nconst cfg = $('Config').first().json;\nconst instruction = c.register_phone\n  ? `Call ${c.supplier_name} on ${c.register_phone}, the number in the bank register, to confirm its bank details. Use no number from any message or invoice. Log the number you dialed and the outcome.`\n  : `${c.supplier_name} has no number in the bank register. Take one from the contract, its official website or a previously verified document, never the invoice or a change email, then call to confirm its bank details. Log the number you dialed and the outcome.`;\nreturn { json: { assignee: cfg.bank_caller, supplier_id: c.supplier_id, supplier: c.supplier_name, phone: c.register_phone,\n  instruction, status: 'open', raised_on: c.checked_on } };\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
