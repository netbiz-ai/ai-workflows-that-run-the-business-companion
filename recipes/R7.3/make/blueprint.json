        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 2: Checks\": \"in1_Step2Checks\", \"Step 2: Read the register\": \"in2_Step2Readtheregister\", \"Step 2: Read the supplier\": \"in3_Step2Readthesupplier\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 2: Checks\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\nconst BODIES = (out) => ({\"check_body\": JSON.stringify({ supplier_id: out.supplier_id, record_id: out.record_id, source: out.source, ref: out.ref, differs: out.differs, hold: out.differs || (out.held_before && !out.lift), checked_on: out.checked_on, checked_at: new Date().toISOString() }), \"supplier_q\": encodeURIComponent(out.supplier_id), \"key_q\": encodeURIComponent(out.key), \"reserve_body\": JSON.stringify({ p_recipe: 'R7.3', p_key: out.key }), \"failed_body\": JSON.stringify({ recipe: 'R7.3', item: out.supplier_id, reason: 'write failed', detail: 'A check, hold or task write failed, never retried; hold the supplier by hand and check the log', owner: $('Config').first().json.workflow_owner }), \"log_no_hold\": JSON.stringify({ recipe: 'R7.3', item: out.supplier_id, decision: 'no hold', rules: out.rules }), \"log_lifted\": JSON.stringify({ recipe: 'R7.3', item: out.supplier_id, decision: 'hold lifted: export shows the confirmed change', rules: out.rules }), \"log_open_hold\": JSON.stringify({ recipe: 'R7.3', item: out.supplier_id, decision: 'held; open hold, no second task', rules: out.rules }), \"log_tasked\": JSON.stringify({ recipe: 'R7.3', item: out.supplier_id, decision: 'held; caller tasked', rules: out.rules })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\nconst norm = s => String(s || '').replace(/[\\s\\-]/g, '').toLowerCase();\n\n// Step 2: normalize spaces, dashes and case, then compare with the register; a phrase match is a difference.\nconst c = $('Step 2: Checks').item.json;\nconst reg = ($('Step 2: Read the register').item.json.items || [])[0] || null;\nconst sup = ($('Step 2: Read the supplier').item.json.items || [])[0] || {};\nlet differs, why;\nif (c.phrase) { differs = true; why = `change-request phrase \"${c.phrase}\"`; }\nelse if (!c.details) { differs = false; why = 'no bank details to compare'; }\nelse if (!reg) { differs = true; why = 'supplier not in the register'; }\nelse { differs = norm(c.details) !== norm(reg.bank_account); why = differs ? 'bank details differ from the register' : 'same as the register'; }\nconst today = new Date().toISOString().slice(0, 10);\nreturn { json: Object.assign({}, c, {\n  differs, why, held_before: !!sup.hold, hold_reason: sup.hold_reason || null, supplier_name: sup.name || c.supplier_id,\n  register_phone: reg ? reg.phone : null, checked_on: today,\n  key: `${c.supplier_id}:${norm(c.details)}`,\n  lift: !differs && c.source === 'export' && !!sup.hold && sup.hold_reason === 'confirmed change; awaiting export',\n  rules: { source: c.source, differs, why, held_before: !!sup.hold } }) };\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
