  {
   "case": "Flow off",
   "row": 11,
   "input": "No export check logged before the payment run (companion extension)",
   "trigger": [
    {
     "webhook": "r7-3-pre-run",
     "body": {
      "run_date": "{today}"
     }
    }
   ],
   "expect": [
    {
     "mock": "suppliers/suppliers/SUP-1",
     "field": "hold",
     "equals": true
    },
    {
     "mock": "suppliers/suppliers/SUP-2",
     "field": "hold",
     "equals": true
    },
    {
     "mock": "messaging/messages/1",
     "field": "to",
     "equals": "helen@example.test"
    }
   ]
  },
  {
   "case": "Hold write fails",
   "row": 12,
   "input": "The hold write fails (companion extension)",
   "seed": {
    "review": {
     "records": {
      "R-1": {
       "bank_account": "GB94 BARC 1020 1530 0934 59"
      }
     }
    }
   },
   "fail": [
    {
     "method": "PATCH",
     "path": "/suppliers/suppliers/SUP-1",
     "status": 500,
     "times": 1
    }
   ],
   "trigger": [
    {
     "webhook": "r7-3-record",
     "body": {
      "record_id": "R-1"
     }
    }
   ],
   "expect": [
    {
     "calls": "PATCH /suppliers/suppliers/SUP-1",
     "count": 1
    },
    {
     "sql": "select reason from exception_queue where recipe='R7.3'",
     "equals": "write failed"
