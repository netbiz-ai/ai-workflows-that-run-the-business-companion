    {
     "sql": "select owner from exception_queue where recipe='R7.3'",
     "equals": "caller@example.test"
    },
    {
     "mock": "suppliers/suppliers/SUP-1",
     "field": "hold",
     "equals": true
    },
    {
     "mock": "register/register/SUP-1",
     "field": "bank_account",
     "equals": "GB29NWBK60161331926819"
    }
   ]
  },
  {
   "case": "Not confirmed",
   "row": 8,
   "input": "The supplier denies the change on the number on file (companion extension)",
   "seed": {
    "suppliers": {
     "suppliers": {
      "SUP-1": {
       "hold": true,
