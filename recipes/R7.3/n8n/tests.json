     "equals": true
    },
    {
     "calls": "PUT /register/register/SUP-1",
     "count": 0
    }
   ]
  },
  {
   "case": "Confirmed change",
   "row": 9,
   "input": "Change confirmed on the number on file, then the next export shows it (companion extension)",
   "seed": {
    "suppliers": {
     "suppliers": {
      "SUP-1": {
       "hold": true,
       "hold_reason": "bank-detail difference"
