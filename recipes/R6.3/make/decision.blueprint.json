    {
      "id": 8,
      "module": "code:ExecuteCode",
      "version": 1,
      "parameters": {},
      "mapper": {
        "language": "javascript",
        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Adapter: the rule below is the same JavaScript as the recipe's n8n build.\n// $('Step name') answers from this step's inputs: each is that step's output in this scenario.\nconst SOURCES = {\"Config\": \"in0_Config\", \"Step 10: Queue: Read the pair\": \"in1_Step10QueueReadthepair\"};\nconst LISTS = [];\nconst EXECUTED = [];\nconst DATA = {};\nfor (const [node, key] of Object.entries(SOURCES)) {\n  const raw = input[key];\n  let v = raw;\n  if (typeof raw === 'string') { try { v = JSON.parse(raw); } catch (e) { v = raw; } }\n  DATA[node] = LISTS.includes(node) ? (v || []).map(i => (i && i.json !== undefined ? i : { json: i })) : [{ json: v }];\n}\nconst $ = (node) => {\n  const ran = node in DATA || EXECUTED.includes(node);\n  const list = () => { if (!(node in DATA)) throw new Error(`step ${node} has no data in this scenario`); return DATA[node]; };\n  return { isExecuted: ran, first: () => list()[0], last: () => list()[list().length - 1], all: () => list(),\n           get item() { return list()[0]; } };\n};\nconst INPUT = \"Step 10: Queue: Read the pair\";\nconst $input = { all: () => $(INPUT).all(), first: () => $(INPUT).first(), last: () => $(INPUT).last(), get item() { return $(INPUT).first(); } };\nconst $execution = { id: input.run_id };\n// The webhook's fields, as n8n reads them: $('Step 10: Decision recorded').first().json.body.\nDATA[\"Step 10: Decision recorded\"] = [{ json: { body: { pair_id: input.t_pair_id, decision: input.t_decision, by: input.t_by } } }];\nconst BODIES = (out) => ({\"suppression_body\": JSON.stringify({ pair: $('Step 10: Queue: Read the pair').first().json.accounts, signals: $('Step 10: Queue: Read the pair').first().json.signals, snapshot: $('Step 10: Queue: Read the pair').first().json.snapshot, rejected_by: $('Step 10: Decision recorded').first().json.body.by, rejected: new Date().toISOString().slice(0, 10) }), \"release_body\": JSON.stringify({ p_recipe: 'R6.3', p_key: $('Step 10: Decision recorded').first().json.body.pair_id }), \"log_body\": JSON.stringify({ recipe: 'R6.3', item: $('Step 10: Decision recorded').first().json.body.pair_id, decision: $('Step 10: Decision recorded').first().json.body.decision + ' by ' + $('Step 10: Decision recorded').first().json.body.by, rules: { signals: $('Step 10: Queue: Read the pair').first().json.signals, confirm_first: $('Step 10: Queue: Read the pair').first().json.confirm_first || [], by: $('Step 10: Decision recorded').first().json.body.by } }), \"exception_body\": JSON.stringify({ recipe: 'R6.3', item: $('Step 10: Decision recorded').first().json.body.pair_id, reason: 'write failed', detail: 'Suppression write failed; the rejected pair may be queued again', owner: $('Config').first().json.merger })});\nconst one = (r) => (Array.isArray(r) ? r : [r]).filter(Boolean).map(i => (i.json !== undefined ? i.json : i));\nconst $json = INPUT && INPUT in DATA ? $input.first().json : {};\nconst __rule = () => {\nreturn [{ json: {} }];\n};\nconst out = one(__rule())[0] || {};\nreturn Object.assign({}, out, BODIES(out));\n",
        "input": [
          {
            "name": "t_pair_id",
            "value": "{{1.pair_id}}"
          },
          {
            "name": "t_decision",
            "value": "{{1.decision}}"
          },
          {
            "name": "t_by",
            "value": "{{1.by}}"
          },
          {
            "name": "in0_Config",
            "value": "{{2.result}}"
          },
          {
            "name": "in1_Step10QueueReadthepair",
            "value": "{{7.data}}"
          },
          {
            "name": "run_id",
            "value": "{{var.scenario.executionId}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Step 10: Build the bodies"
        }
      }
    },
