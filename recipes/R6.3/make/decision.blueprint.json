        "inputFormat": "editor",
        "dependencies": [],
        "codeEditorJavascript": "// Config: edit these values for your company; nothing else in the scenario hard-codes them.\nreturn {\n  \"stop_flag_url\": \"https://<your stop list API>/stop_flags/R6.3\",\n  \"table_api_url\": \"https://<your table API for the key log, decision log and exception queue>\",\n  \"workflow_owner\": \"<your workflow owner>\",\n  \"export_url\": \"https://<your CRM export API>\",\n  \"queue_url\": \"https://<your merge queue and suppression list API>\",\n  \"messaging_url\": \"https://<your messaging API>\",\n  \"account_fields\": [\n    \"id\",\n    \"name\",\n    \"phone\",\n    \"tax_id\",\n    \"billing_address\",\n    \"email\",\n    \"open_quotes\",\n    \"credit_terms\",\n    \"links\"\n  ],\n  \"contact_fields\": [\n    \"id\",\n    \"account_id\",\n    \"email\"\n  ],\n  \"expected_accounts\": 400,\n  \"max_shrink_pct\": 20,\n  \"excluded_domains\": [\n    \"<your webmail and shared domains>\"\n  ],\n  \"default_country_code\": \"<your country calling code, digits only>\",\n  \"name_suffixes\": [\n    \"inc\",\n    \"llc\",\n    \"ltd\"\n  ],\n  \"address_abbreviations\": {\n    \"street\": \"st\",\n    \"avenue\": \"ave\",\n    \"road\": \"rd\",\n    \"drive\": \"dr\",\n    \"boulevard\": \"blvd\",\n    \"suite\": \"ste\"\n  },\n  \"signal_terms\": {\n    \"tax_id\": [\n      \"tax\"\n    ],\n    \"phone\": [\n      \"phone\",\n      \"telephone\"\n    ],\n    \"billing_address\": [\n      \"address\"\n    ],\n    \"email_domain\": [\n      \"domain\",\n      \"email\"\n    ],\n    \"name\": [\n      \"name\"\n    ]\n  },\n  \"other_field_terms\": [\n    \"<your CRM's other field names>\"\n  ],\n  \"open_quote_confirmer\": \"<your sales lead>\",\n  \"credit_terms_confirmer\": \"<your finance lead>\",\n  \"merger\": \"<your named merger>\",\n  \"export_owner\": \"<the person who fixes the export>\",\n  \"ai_model\": \"claude-haiku-5-5\",\n  \"ai_inference_geo\": \"us\",\n  \"ai_url\": \"https://api.anthropic.com/v1/messages\"\n};",
        "input": []
