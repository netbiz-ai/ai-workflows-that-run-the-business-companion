{
 "config": {
  "table_url": "{mocks}/sharepoint",
  "thresholds_url": "{mocks}/thresholds",
  "chat_url": "{mocks}/chat",
  "email_url": "{mocks}/email",
  "alert_log_url": "{mocks}/alertlog",
  "preread_url": "{mocks}/preread",
  "list_editor": "owen@example.test"
 },
 "seed": {
  "sharepoint": {
   "versions": {
    "V-1": {
     "id": "V-1",
     "week": "{today-1}",
     "cutoff": "{today-1}T17:00:00Z",
     "status": "written"
    }
   },
   "weekly_table": {
    "V-1:Overdue work orders": {
     "id": "V-1:Overdue work orders",
     "version": "V-1",
     "week": "{today-1}",
     "measure": "Overdue work orders",
     "value": 18,
     "change": 6,
     "cutoff": "{today-1}T17:00:00Z",
     "source": "Delivery scheduling",
     "source_link": "https://lists.example.test/snapshots/V-1:overdue-work-orders",
     "status": "fresh"
    },
    "V-1:Open tickets": {
     "id": "V-1:Open tickets",
     "version": "V-1",
     "week": "{today-1}",
     "measure": "Open tickets",
     "value": 4,
     "change": -2,
     "cutoff": "{today-1}T17:00:00Z",
     "source": "Helpdesk",
     "source_link": "https://lists.example.test/snapshots/V-1:open-tickets",
     "status": "fresh"
    },
    "V-1:Staff absences": {
     "id": "V-1:Staff absences",
     "version": "V-1",
     "week": "{today-1}",
     "measure": "Staff absences",
     "value": "fewer than 3",
     "change": null,
     "cutoff": "{today-1}T17:00:00Z",
     "source": "HR weekly form",
     "source_link": "https://lists.example.test/snapshots/V-1:staff-absences",
     "status": "fewer than 3"
    }
   }
  },
  "thresholds": {
   "lines": {
    "L-1": {
     "id": "L-1",
     "measure": "Overdue work orders",
     "version": 1,
     "field": "value",
     "direction": "above",
     "line": 15,
     "inclusive": false,
     "measure_owner": "tom@example.test",
     "data_owner": "dispatch-lead@example.test",
     "approver": "Tom Rivera",
     "approved_at": "{today-30}T10:00:00Z"
    },
    "L-2": {
     "id": "L-2",
     "measure": "Open tickets",
     "version": 1,
     "field": "value",
     "direction": "above",
     "line": 10,
     "inclusive": false,
     "measure_owner": "helpdesk-lead@example.test",
     "data_owner": "helpdesk-owner@example.test",
     "approver": "Tom Rivera",
     "approved_at": "{today-30}T10:00:00Z"
    },
    "L-3": {
     "id": "L-3",
     "measure": "Staff absences",
     "version": 1,
     "field": "value",
     "direction": "above",
     "line": 0,
     "inclusive": false,
     "measure_owner": "aisha@example.test",
     "data_owner": "aisha@example.test",
     "approver": "Tom Rivera",
     "approved_at": "{today-30}T10:00:00Z"
    }
   }
  }
 },
 "cases": [
  {
   "case": "Normal",
   "row": 1,
   "input": "Overdue work orders past Tom's line, fresh",
   "trigger": [
    {
     "webhook": "r12-3-version-current",
     "body": {
      "version": "V-1"
     }
    }
   ],
   "expect": [
    {
     "mock": "chat/messages",
     "count": 1
    },
    {
     "mock": "chat/messages/1",
     "field": "to",
     "equals": "tom@example.test"
    },
    {
     "mock": "chat/messages/1",
     "field": "text",
     "contains": "https://lists.example.test/snapshots/V-1:overdue-work-orders"
    },
    {
     "mock": "chat/messages/1",
     "field": "text",
     "contains": "value 18, change 6"
    },
    {
     "mock": "alertlog/alerts",
     "count": 1
    },
    {
     "sql": "select count(*) from decision_log where recipe='R12.3'",
     "equals": "3"
    },
    {
     "sql": "select decision from decision_log where recipe='R12.3' and item like '%Staff absences'",
     "equals": "not checked: no alert"
    }
   ]
  },
  {
   "case": "Edge",
   "row": 2,
   "input": "Figure past the line but stale",
   "seed": {
    "sharepoint": {
     "weekly_table": {
      "V-1:Overdue work orders": {
       "value": null,
       "change": null,
       "status": "stale",
       "last_good": "{today-8}"
      }
     }
    }
   },
   "trigger": [
    {
     "webhook": "r12-3-version-current",
     "body": {
      "version": "V-1"
     }
    }
   ],
   "expect": [
    {
     "mock": "chat/messages",
     "count": 1
    },
    {
     "mock": "chat/messages/1",
     "field": "to",
     "equals": "dispatch-lead@example.test"
    },
    {
     "mock": "chat/messages/1",
     "field": "text",
     "contains": "Last good: {today-8}"
    }
   ]
  },
  {
   "case": "Duplicate",
   "row": 3,
   "input": "New table version, same outcome",
   "seed": {
    "sharepoint": {
     "versions": {
      "V-2": {
       "id": "V-2",
       "week": "{today-1}",
       "cutoff": "{today-1}T17:00:00Z",
       "status": "written"
      }
     },
     "weekly_table": {
      "V-2:Overdue work orders": {
       "id": "V-2:Overdue work orders",
       "version": "V-2",
       "week": "{today-1}",
       "measure": "Overdue work orders",
       "value": 18,
       "change": 6,
       "cutoff": "{today-1}T17:00:00Z",
       "source": "Delivery scheduling",
       "source_link": "https://lists.example.test/snapshots/V-1:overdue-work-orders",
       "status": "fresh"
      },
      "V-2:Open tickets": {
       "id": "V-2:Open tickets",
       "version": "V-2",
       "week": "{today-1}",
       "measure": "Open tickets",
       "value": 4,
       "change": -2,
       "cutoff": "{today-1}T17:00:00Z",
       "source": "Helpdesk",
       "source_link": "https://lists.example.test/snapshots/V-1:open-tickets",
       "status": "fresh"
      },
      "V-2:Staff absences": {
       "id": "V-2:Staff absences",
       "version": "V-2",
       "week": "{today-1}",
       "measure": "Staff absences",
       "value": "fewer than 3",
       "change": null,
       "cutoff": "{today-1}T17:00:00Z",
       "source": "HR weekly form",
       "source_link": "https://lists.example.test/snapshots/V-1:staff-absences",
       "status": "fewer than 3"
      }
     }
    }
   },
   "trigger": [
    {
     "webhook": "r12-3-version-current",
     "body": {
      "version": "V-1"
     },
     "pause": 3
    },
    {
     "webhook": "r12-3-version-current",
     "body": {
      "version": "V-2"
     }
    }
   ],
   "expect": [
    {
     "mock": "chat/messages",
     "count": 1
    },
    {
     "sql": "select copies_skipped from key_log where recipe='R12.3' and key like '%Overdue work orders%'",
     "equals": "1"
    },
    {
     "sql": "select count(*) from decision_log where recipe='R12.3' and decision like '%suppressed%'",
     "equals": "3"
    }
   ]
  },
  {
   "case": "Refuse",
   "row": 4,
   "input": "Line raised and approved Thursday at 3 p.m.",
