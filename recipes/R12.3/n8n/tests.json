       "subject": "Weekly figures: Overdue work orders is past your line",
       "cutoff": "{today-1}T17:00:00Z",
       "seen": false
      },
      "A-2": {
       "id": "A-2",
       "week": "{today-1}",
       "measure": "Open tickets",
