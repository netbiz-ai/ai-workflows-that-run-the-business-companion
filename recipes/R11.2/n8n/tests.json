{
  "config": {
    "requests_url": "{mocks}/sharepoint",
    "vendors_url": "{mocks}/vendors",
    "policy_url": "{mocks}/policy",
    "ledger_url": "{mocks}/ledger",
    "messaging_url": "{mocks}/messaging",
    "price_approver": "tom@example.test",
    "backstop_reviewer": "aisha@example.test"
  },
  "seed": {
    "sharepoint": {"requests": {
      "REQ-1": {"id": "REQ-1", "version": 1, "status": "ready", "requester": "requester@example.test",
                "supplier_id": "SUP-1", "budget_line": "BL-STORE", "category": "store fixtures", "amount": 2400,
                "created": "{today}", "lines": [{"item": "shelf-unit", "qty": 10, "unit_price": 240}],
                "comparison": {"checked": true}, "waiver": null,
                "quote": {"matches": true, "valid_until": "{today+20}", "freight": "included"}}
    }},
    "vendors": {"records": {"SUP-1": {"id": "SUP-1", "active": true, "hold": false}}},
    "policy": {"budget_lines": {"BL-STORE": {"id": "BL-STORE", "allowed_categories": ["store fixtures"], "waiver_grantors": ["Tom Rivera"]}}},
    "ledger": {"last_prices": {"shelf-unit": {"item": "shelf-unit", "unit_price": 250}}, "pos": {}}
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "$2,400, checked row, quote valid 20 days",
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "checked; to approval"},
       {"mock": "sharepoint/requests/REQ-1", "field": "total", "equals": 2400},
       {"sql": "select status from key_log where recipe='R11.2'", "equals": "done"},
       {"sql": "select count(*) from decision_log where recipe='R11.2'", "equals": "1"}]},
    {"case": "Edge", "row": 2, "input": "Quote valid until tomorrow",
     "seed": {"sharepoint": {"requests": {"REQ-1": {"quote": {"matches": true, "valid_until": "{today+1}", "freight": "included"}}}}},
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "blocked"},
       {"mock": "sharepoint/requests/REQ-1", "field": "reasons", "contains": "expires within margin"},
       {"mock": "messaging/messages", "count": 1}]},
    {"case": "Duplicate", "row": 3, "input": "Status write, version unchanged",
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}, "pause": 2},
                 {"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"calls": "PATCH /sharepoint/requests/REQ-1", "count": 1},
       {"sql": "select copies_skipped from key_log where recipe='R11.2'", "equals": "1"},
       {"sql": "select count(*) from decision_log where recipe='R11.2'", "equals": "1"}]},
    {"case": "Refuse", "row": 4, "input": "Supplier on R7.3 hold",
     "seed": {"vendors": {"records": {"SUP-1": {"hold": true}}}},
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "blocked"},
       {"mock": "sharepoint/requests/REQ-1", "field": "reasons", "contains": "supplier on hold"}]},
    {"case": "Escalate", "row": 5, "input": "Two $450 requests, same supplier, three days apart",
     "seed": {"sharepoint": {"requests": {
       "REQ-1": {"amount": 450, "created": "{today}", "lines": [{"item": "shelf-unit", "qty": 2, "unit_price": 225}]},
       "REQ-0": {"id": "REQ-0", "version": 1, "status": "no PO needed", "requester": "requester@example.test",
                 "supplier_id": "SUP-1", "budget_line": "BL-STORE", "category": "store fixtures", "amount": 450, "created": "{today-3}"}}}},
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"mock": "sharepoint/requests/REQ-1", "field": "status", "equals": "checked; to approval"},
       {"mock": "sharepoint/requests/REQ-1", "field": "total", "equals": 900}]},
    {"case": "Failure", "row": 6, "input": "Status write fails (companion extension)",
     "fail": [{"method": "PATCH", "path": "/sharepoint/requests/REQ-1", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r11-2-request", "body": {"request_id": "REQ-1", "version": 1}}],
     "expect": [
       {"calls": "PATCH /sharepoint/requests/REQ-1", "count": 1},
       {"sql": "select status from key_log where recipe='R11.2'", "equals": "failed"},
       {"sql": "select reason from exception_queue where recipe='R11.2'", "equals": "write failed"}]},
    {"case": "Backstop", "row": 7, "input": "A $1,200 PO with no approved request (companion extension)",
     "seed": {"ledger": {"pos": {"PO-9": {"id": "PO-9", "amount": 1200, "request_id": null}}}},
     "trigger": [{"schedule": "Step 11: Each morning"}],
     "expect": [
       {"sql": "select reason from exception_queue where recipe='R11.2'", "equals": "PO without approved request"},
       {"mock": "messaging/messages", "count": 1}]}
  ]
}
