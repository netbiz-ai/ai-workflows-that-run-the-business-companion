            "value": "{{14.data}}"
          },
          {
            "name": "in5_Readrecentrequests",
            "value": "{{16.data}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0,
          "name": "Rules: steps 3 to 8"
        }
      }
