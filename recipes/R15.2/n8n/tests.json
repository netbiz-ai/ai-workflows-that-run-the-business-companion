{
  "config": {
    "briefs_url": "{mocks}/briefs",
    "scheduling_url": "{mocks}/scheduling",
    "messaging_url": "{mocks}/messaging",
    "capacity_owner": "tom@example.test",
    "promotion_owner": "ben@example.test",
    "systems_owner": "owen@example.test"
  },
  "seed": {
    "briefs": {"briefs": {
      "B-1": {"id": "B-1", "version": 1, "approval": "ready", "capacity": null, "live": false,
              "promise": "installed within 10 days", "waves": [{"wave": 1}, {"wave": 2}],
              "weeks": [{"week": "2026-11-02", "forecast": 15}, {"week": "2026-11-09", "forecast": 15}, {"week": "2026-11-16", "forecast": 15}]}
    }},
    "scheduling": {
      "exports": {"latest": {"id": "latest", "exported_at": "{today}T00:00:00Z", "weeks": [
        {"week": "2026-11-02", "open_slots": 30, "promoted_booked": 0},
        {"week": "2026-11-09", "open_slots": 30, "promoted_booked": 0},
        {"week": "2026-11-16", "open_slots": 30, "promoted_booked": 0}]}},
      "averages": {"non-promoted": {"id": "non-promoted", "weekly_average": 5}}
    }
  },
  "cases": [
    {"case": "Normal", "row": 1, "input": "Forecast 15 a week; 25 free",
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "cleared"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_figures", "contains": "\"free\": 25"},
       {"mock": "messaging/messages", "count": 0},
       {"sql": "select status from key_log where recipe='R15.2'", "equals": "done"},
       {"sql": "select decision from decision_log where recipe='R15.2'", "equals": "check: cleared"}]},
    {"case": "Edge", "row": 2, "input": "Fits the window, not week one",
     "seed": {"briefs": {"briefs": {"B-1": {"weeks": [{"week": "2026-11-02", "forecast": 30}, {"week": "2026-11-09", "forecast": 10}, {"week": "2026-11-16", "forecast": 10}]}}}},
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "held"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": ["week 2026-11-02 short by 5"]},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["tom@example.test", "ben@example.test"]},
       {"mock": "messaging/messages/1", "field": "text", "contains": "short by 5"}]},
    {"case": "Duplicate", "row": 3, "input": "Brief re-marked \"ready\"",
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}, "pause": 2},
                 {"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"calls": "PATCH /briefs/briefs/B-1", "count": 1},
       {"sql": "select copies_skipped from key_log where recipe='R15.2'", "equals": "1"},
       {"sql": "select count(*) from decision_log where recipe='R15.2'", "equals": "1"}]},
    {"case": "Escalate", "row": 4, "input": "Live week at 90%",
     "seed": {"briefs": {"briefs": {"B-1": {"approval": "approved", "capacity": "cleared", "live": true,
                "capacity_figures": {"weeks": [{"week": "2026-11-02", "free": 10}, {"week": "2026-11-09", "free": 10}, {"week": "2026-11-16", "free": 10}]}}}},
              "scheduling": {"exports": {"latest": {"weeks": [
                {"week": "2026-11-02", "open_slots": 6, "promoted_booked": 9},
                {"week": "2026-11-09", "open_slots": 20, "promoted_booked": 2},
                {"week": "2026-11-16", "open_slots": 28, "promoted_booked": 0}]}}}},
     "trigger": [{"schedule": "Step 1: Each working morning"}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "held"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": ["week 2026-11-02 at 90% of its planned share"]},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["tom@example.test", "ben@example.test"]},
       {"mock": "messaging/messages/1", "field": "subject", "equals": "Promotion B-1: next wave held"}]},
    {"case": "Stale export", "row": 5, "input": "Slot export two days old (companion extension)",
     "seed": {"scheduling": {"exports": {"latest": {"exported_at": "{today-2}T00:00:00Z"}}}},
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "held"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": ["slot export stale"]},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["owen@example.test"]},
       {"sql": "select owner from exception_queue where recipe='R15.2'", "equals": "owen@example.test"}]},
    {"case": "Export format changed", "row": 6, "input": "Slot export with no week columns (companion extension)",
     "seed": {"scheduling": {"exports": {"latest": {"weeks": null, "Week 1": 30}}}},
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "held"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": ["export format changed"]},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["owen@example.test"]},
       {"sql": "select detail from exception_queue where recipe='R15.2'", "equals": "export format changed: Slot export has no week columns"}]},
    {"case": "No forecast", "row": 7, "input": "A week with no forecast (companion extension)",
     "seed": {"briefs": {"briefs": {"B-1": {"weeks": [{"week": "2026-11-02", "forecast": 15}, {"week": "2026-11-09", "forecast": null}, {"week": "2026-11-16", "forecast": 15}]}}}},
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "held"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": ["no forecast for week 2026-11-09"]},
       {"mock": "messaging/messages/1", "field": "to", "equals": ["tom@example.test"]},
       {"sql": "select owner from exception_queue where recipe='R15.2'", "equals": "tom@example.test"}]},
    {"case": "Recheck", "row": 8, "input": "Held brief; Tom adds crew time and the morning export fits (companion extension)",
     "seed": {"briefs": {"briefs": {"B-1": {"capacity": "held", "capacity_reasons": ["week 2026-11-02 short by 5"]}}}},
     "trigger": [{"schedule": "Step 1: Each working morning"}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "cleared"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_reasons", "equals": []},
       {"mock": "messaging/messages", "count": 0}]},
    {"case": "Live and fitting", "row": 9, "input": "Live weeks at 80% or less (companion extension)",
     "seed": {"briefs": {"briefs": {"B-1": {"approval": "approved", "capacity": "cleared", "capacity_checked_at": "{today-1}T07:00:00Z", "live": true,
                "capacity_figures": {"weeks": [{"week": "2026-11-02", "free": 10}, {"week": "2026-11-09", "free": 10}, {"week": "2026-11-16", "free": 10}]}}}},
              "scheduling": {"exports": {"latest": {"weeks": [
                {"week": "2026-11-02", "open_slots": 7, "promoted_booked": 8},
                {"week": "2026-11-09", "open_slots": 20, "promoted_booked": 2},
                {"week": "2026-11-16", "open_slots": 28, "promoted_booked": 0}]}}}},
     "trigger": [{"schedule": "Step 1: Each working morning"}],
     "expect": [
       {"mock": "briefs/briefs/B-1", "field": "capacity", "equals": "cleared"},
       {"mock": "briefs/briefs/B-1", "field": "capacity_checked_at", "contains": "{today}"},
       {"mock": "messaging/messages", "count": 0}]},
    {"case": "Write fails", "row": 10, "input": "Capacity status write fails (companion extension)",
     "fail": [{"method": "PATCH", "path": "/briefs/briefs/B-1", "status": 500, "times": 1}],
     "trigger": [{"webhook": "r15-2-brief-ready", "body": {"brief_id": "B-1"}}],
     "expect": [
       {"calls": "PATCH /briefs/briefs/B-1", "count": 1},
       {"sql": "select status from key_log where recipe='R15.2'", "equals": "failed"},
       {"sql": "select reason from exception_queue where recipe='R15.2'", "equals": "write failed"}]}
  ]
}
